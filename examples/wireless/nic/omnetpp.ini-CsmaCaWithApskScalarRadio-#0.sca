config record-eventlog false
config sim-time-limit 100s
config extends "AbstractCsmaCa, AbstractApskScalarRadio"
config description "CsmaCa mac with scalar radio"
config *.host[*].wlan[*].mac.bitrate 2Mbps
config *.host[*].wlan[*].radio.transmitter.bitrate 2Mbps
config *.host[*].wlan[*].typename CsmaCaInterface
config *.host[*].wlan[*].mac.ackTimeout 120us
config *.host[*].wlan[*].mac.headerLength 25B
config *.radioMedium.signalAnalogRepresentation "\"scalar\""
config *.radioMedium.backgroundNoise.power -110dBm
config *.host[*].wlan[*].radio.typename ApskRadio
config *.host[*].wlan[*].radio.signalAnalogRepresentation "\"scalar\""
config *.host[*].wlan[*].radio.centerFrequency 2.412GHz
config *.host[*].wlan[*].radio.bandwidth 2MHz
config *.host[*].wlan[*].radio.transmitter.power 2mW
config *.host[*].wlan[*].radio.transmitter.preambleDuration 0s
config *.host[*].wlan[*].radio.transmitter.headerLength 96b
config *.host[*].wlan[*].radio.transmitter.modulation "\"BPSK\""
config *.host[*].wlan[*].radio.receiver.sensitivity -85dBm
config *.host[*].wlan[*].radio.receiver.energyDetection -85dBm
config *.host[*].wlan[*].radio.receiver.snirThreshold 4dB
config num-rngs 3
config network TestNic
config **.mobility.rng-0 1
config **.wlan[*].mac.rng-0 2
config *.numHosts 2
config **.host[0].numPcapRecorders 1
config **.host[0].pcapRecorder[*].pcapFile "\"results/host0.pcap\""
