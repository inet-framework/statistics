version 3
run CsmaCaWithApskScalarRadio-0-20261026-16:52:54-4487
attr configname CsmaCaWithApskScalarRadio
attr datetime 20261026-16:52:54
attr datetimef 20261026-165254
attr experiment CsmaCaWithApskScalarRadio
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network TestNic
attr processid 4487
