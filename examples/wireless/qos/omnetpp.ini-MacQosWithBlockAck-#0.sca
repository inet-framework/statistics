config **.param-recording false
config image-path /home/miguel/workspace/inet-ieee80211-basic-blockack-recovery/ai-logs/basic-blockack-recovery/devin-causal/model/images
config output-scalar-file results/omnetpp.ini-MacQosWithBlockAck-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-MacQosWithBlockAck-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 10s
config description "This QoS example uses historical Basic Block Ack from IEEE 802.11e-2005, which IEEE 802.11-2024 does not support."
config sim-time-limit 10s
config extends MacQos
config **.isBlockAckSupported true
config *.cliHost.wlan[*].mac.hcf.blockAckVariant "\"basic\""
config *.srvHost.wlan[*].mac.hcf.blockAckVariant "\"basic\""
config *.ap.wlan[*].mac.hcf.blockAckVariant "\"basic\""
config *.radioMedium.sameTransmissionStartTimeCheck "\"ignore\""
config sim-time-limit 10s
config extends MacNonQos
config **.wlan[*].classifier.typename ExampleQosClassifier
config **.mac.hcf.edca.edcaf[*].pendingQueue.packetCapacity -1
config **.mac.qosStation true
config **.mac.hcf.originatorMacDataService.msduAggregationPolicy.typename BasicMsduAggregationPolicy
config sim-time-limit 10s
config **.wlan[*].mac.typename Ieee80211Mac
config **.mac.dcf.channelAccess.pendingQueue.packetCapacity -1
config network QosThroughput
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 400m
config **.constraintAreaMaxY 400m
config **.constraintAreaMaxZ 0m
config **.mobility.initFromDisplayString false
config **.cliHost.mobility.initialX 100m
config **.cliHost.mobility.initialY 100m
config **.srvHost.mobility.initialX 300m
config **.srvHost.mobility.initialY 100m
config **.ap.mobility.initialX 200m
config **.ap.mobility.initialY 200m
config **.mobility.initialZ 0m
config **.opMode "\"g(mixed)\""
config **.ap.wlan[*].address "\"10:00:00:00:00:00\""
config **.radio.transmitter.power 2000mW
config **.radio.receiver.sensitivity -85dBm
config **.radio.receiver.snirThreshold 4dB
config **.cliHost.numApps 4
config **.cliHost.app[*].typename UdpBasicApp
config **.cliHost.app[*].destAddresses "\"srvHost\""
config **.cliHost.app[0].destPort 21
