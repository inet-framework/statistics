attr experiment MacQosWithBlockAck
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network QosThroughput
attr processid 2892125
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
