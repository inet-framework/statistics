attr configname OrbitY
attr datetime 20260916-13:03:57
attr datetimef 20260916-130357
attr experiment OrbitY
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network AntennaDirectionalSelectivityExample
attr processid 3852
attr repetition 0
