config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-OrbitY-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-OrbitY-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1h
config extends Orbit
config description "Host A dipole points towards Y axis, Host B dipole points towards Z axis, Host B orbits around Host A in XY plane starting from X axis towards Y axis"
config *.hostA.mobility.initialHeading 0deg
config *.hostA.mobility.initialElevation 0deg
config *.hostA.mobility.initialBank 90deg
config *.hostA.mobility.typename StationaryMobility
config *.hostA.mobility.initFromDisplayString false
config *.hostA.mobility.initialX 500m
config *.hostA.mobility.initialY 500m
config *.hostA.mobility.initialZ 0m
config *.hostB.mobility.typename CircleMobility
config *.hostB.mobility.cx 500m
config *.hostB.mobility.cy 500m
config *.hostB.mobility.cz 0m
config *.hostB.mobility.r 300m
config *.hostB.mobility.startAngle 0deg
config *.hostB.mobility.speed 0.52359877559mps
config network AntennaDirectionalSelectivityExample
config *.host*.mobility.constraintAreaMinZ 0m
config *.host*.mobility.constraintAreaMinX 0m
config *.host*.mobility.constraintAreaMinY 0m
config *.host*.mobility.constraintAreaMaxX 1000m
config *.host*.mobility.constraintAreaMaxY 1000m
config *.host*.mobility.constraintAreaMaxZ 0m
config *.hostA.numApps 1
config *.hostA.app[0].typename PingApp
config *.hostA.app[0].destAddr "\"hostB\""
config *.hostA.app[0].startTime 0s
config *.host*.wlan[*].radio.antenna.typename DipoleAntenna
config *.host*.wlan[*].radio.antenna.length 20cm

