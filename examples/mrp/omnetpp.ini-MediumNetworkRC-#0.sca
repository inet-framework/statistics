version 3
run MediumNetworkRC-0-20260916-13:03:26-3212
attr configname MediumNetworkRC
attr datetime 20260916-13:03:26
attr datetimef 20260916-130326
attr experiment MediumNetworkRC
attr inifile omnetpp.ini
attr iterationvars "$timingProfile=500, $ccmInterval=10"
attr iterationvarsd timingProfile=500/ccmInterval=10
attr iterationvarsf timingProfile=500,ccmInterval=10-
