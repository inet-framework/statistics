attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar ccmInterval 10
itervar timingProfile 500
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-MediumNetworkRC-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-MediumNetworkRC-#0.vec
