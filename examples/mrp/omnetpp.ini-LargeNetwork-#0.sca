version 3
run LargeNetwork-0-20260916-13:03:26-3172
attr configname LargeNetwork
attr datetime 20260916-13:03:26
attr datetimef 20260916-130326
attr experiment LargeNetwork
attr inifile omnetpp.ini
attr iterationvars "$timingProfile=500, $ccmInterval=10, $enableLinkCheckOnRing=false"
attr iterationvarsd timingProfile=500/ccmInterval=10/enableLinkCheckOnRing=false
attr iterationvarsf timingProfile=500,ccmInterval=10,enableLinkCheckOnRing=false-
attr measurement "$timingProfile=500, $ccmInterval=10, $enableLinkCheckOnRing=false"
attr network MrpRing
attr processid 3172
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar ccmInterval 10
itervar enableLinkCheckOnRing false
itervar timingProfile 500
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-LargeNetwork-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-LargeNetwork-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 3s
config network MrpRing
config description "50 Nodes, 1 ring"
config *.numNodes 50
config *.node[0].mrp.mrpRole "\"MRM\""
config **.mrp.mrpRole "\"MRC\""
config **.hasStatus true
config **.script "xmldoc(\"scripts.xml\", \"//script[@id='LargeNetwork-disconnect']\")"
config **.mrp.timingProfile "500 ms"
config **.mrp.ccmInterval "10 ms"
config **.mrp.enableLinkCheckOnRing false
config simtime-resolution us
config **.numEthInterfaces 2
config **.mrp.uuid0 333
config **.mrp.uuid1 999
config **.channel.delay 500ns
config **.bitrate 100Mbps
config **.mtu 1500B
config *.visualizer.infoVisualizer.modules "\"*.*.mrp\""
config *.visualizer.infoVisualizer.format "\"%t\""
config *.visualizer.infoVisualizer.placementHint "\"topCenter\""
config *.visualizer.infoVisualizer.textColor "\"blue\""
config *.visualizer.infoVisualizer.textAlignment "\"center\""
config *.visualizer.infoVisualizer.backgroundColor "\"\""
config *.visualizer.infoVisualizer.lineColor "\"\""
config **.annotationSpacing 0

