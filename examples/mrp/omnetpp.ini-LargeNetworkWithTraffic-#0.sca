config *.node[0].mrp.mrpRole "\"MRM\""
config **.mrp.mrpRole "\"MRC\""
config **.hasStatus true
config **.script "xmldoc(\"scripts.xml\", \"//script[@id='LargeNetwork-disconnect']\")"
