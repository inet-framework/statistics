version 3
run SmallNetwork-0-20260916-13:03:27-3234
attr configname SmallNetwork
attr datetime 20260916-13:03:27
attr datetimef 20260916-130327
attr experiment SmallNetwork
attr inifile omnetpp.ini
attr iterationvars "$script=disconnect, $timingProfile=500, $ccmInterval=10, $enableLinkCheckOnRing=false"
attr iterationvarsd script=disconnect/timingProfile=500/ccmInterval=10/enableLinkCheckOnRing=false
attr iterationvarsf script=disconnect,timingProfile=500,ccmInterval=10,enableLinkCheckOnRing=false-
