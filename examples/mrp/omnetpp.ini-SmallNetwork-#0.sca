config **.channel.delay 500ns
config **.bitrate 100Mbps
config **.mtu 1500B
config *.visualizer.infoVisualizer.modules "\"*.*.mrp\""
config *.visualizer.infoVisualizer.format "\"%t\""
config *.visualizer.infoVisualizer.placementHint "\"topCenter\""
config *.visualizer.infoVisualizer.textColor "\"blue\""
config *.visualizer.infoVisualizer.textAlignment "\"center\""
config *.visualizer.infoVisualizer.backgroundColor "\"\""
config *.visualizer.infoVisualizer.lineColor "\"\""
config **.annotationSpacing 0

