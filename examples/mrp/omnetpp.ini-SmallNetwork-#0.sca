attr network Mrp4
attr processid 3234
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar ccmInterval 10
itervar enableLinkCheckOnRing false
itervar script disconnect
itervar timingProfile 500
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-SmallNetwork-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-SmallNetwork-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 3s
config extends SmallNetworkBase
config *.node0.mrp.mrpRole "\"MRM\""
config **.mrp.mrpRole "\"MRC\""
config description "4 Nodes - 1 Ring"
config network Mrp4
config **.hasStatus true
config **.script "xmldoc(\"scripts.xml\", \"//script[@id='SmallNetwork-disconnect']\")"
config **.mrp.timingProfile "500 ms"
config **.mrp.ccmInterval "10 ms"
config **.mrp.enableLinkCheckOnRing false
config simtime-resolution us
config **.numEthInterfaces 2
config **.mrp.uuid0 333
