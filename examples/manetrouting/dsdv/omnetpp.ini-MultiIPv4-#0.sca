config record-eventlog false
config sim-time-limit 10s
config description "using Ipv4 on multiple network protocols"
config extends _IPv4,_Multi
config *.host[0].app[0].destAddr "\"host[1](ipv4)\""
config **.host[*].hasIpv4 true
