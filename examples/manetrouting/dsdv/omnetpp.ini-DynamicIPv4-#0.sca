run DynamicIPv4-0-20260916-13:02:30-2773
attr configname DynamicIPv4
attr datetime 20260916-13:02:30
attr datetimef 20260916-130230
attr experiment DynamicIPv4
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network DsdvNetwork
attr processid 2773
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
