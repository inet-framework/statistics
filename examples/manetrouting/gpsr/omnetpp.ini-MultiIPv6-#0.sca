attr datetimef 20260917-083843
attr experiment MultiIPv6
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network GPSRNetworkRandom
attr processid 3145
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
