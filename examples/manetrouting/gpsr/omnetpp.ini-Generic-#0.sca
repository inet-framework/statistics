config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Generic-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Generic-#0.vec
