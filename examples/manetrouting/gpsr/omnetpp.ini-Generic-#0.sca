config record-eventlog false
config sim-time-limit 20s
config extends "Random, _Generic"
config description "network layer for generic network protocol only"
config **.hasIpv4 false
config **.hasGn true
config network GPSRNetworkRandom
config *.numHosts 20
config **.host[*].mobility.typename StationaryMobility
config *.host[*].numApps 1
config *.host[*].app[0].typename PingApp
config *.host[*].app[0].startTime uniform(1s,5s)
config *.host[*].app[0].printPing true
config **.generic.typename NextHopNetworkLayer
config **.gpsr.networkProtocolModule "\"^.generic.nextHop\""
config **.gpsr.routingTableModule "\"^.generic.routingTable\""
