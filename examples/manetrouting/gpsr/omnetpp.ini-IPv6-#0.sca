version 3
run IPv6-0-20261028-08:33:30-1390
attr configname IPv6
attr datetime 20261028-08:33:30
attr datetimef 20261028-083330
attr experiment IPv6
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network GPSRNetworkRandom
attr processid 1390
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-IPv6-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-IPv6-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 20s
config extends "Random, _IPv6"
config description "network layer for Ipv6 network protocol only"
config **.hasIpv4 false
config **.hasIpv6 true
config network GPSRNetworkRandom
config *.numHosts 20
config **.host[*].mobility.typename StationaryMobility
config *.host[*].numApps 1
config *.host[*].app[0].typename PingApp
config *.host[*].app[0].startTime uniform(1s,5s)
config *.host[*].app[0].printPing true
config **.gpsr.networkProtocolModule "\"^.ipv6.ipv6\""
config **.gpsr.routingTableModule "\"^.ipv6.routingTable\""
config *.hasIpv6Configurator true
config **.ipv6.configurator.networkConfiguratorModule "\"ipv6Configurator\""
config *.ipv6Configurator.config "xml(\"<config><interface hosts='*' prefix='2001:db8::/64'/></config>\")"
config **.ipv6.ipv6.sendRedirects false
config *.host[0].app[0].destAddr "\"host[1](ipv6)\""
config num-rngs 3
config **.mobility.rng-0 1
config **.wlan[*].mac.rng-0 2
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.mobility.constraintAreaMinX 0m
config **.mobility.constraintAreaMinY 0m
config **.mobility.constraintAreaMaxX 1000m
config **.mobility.constraintAreaMaxY 1000m
config **.wlan[*].bitrate 2Mbps
config **.wlan[*].mac.dcf.channelAccess.cwMin 7
config **.wlan[*].radio.transmitter.power 2mW

