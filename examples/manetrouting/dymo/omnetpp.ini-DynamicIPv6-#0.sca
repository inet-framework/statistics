version 3
run DynamicIPv6-0-20261028-08:33:27-1273
attr configname DynamicIPv6
attr datetime 20261028-08:33:27
attr datetimef 20261028-083327
attr experiment DynamicIPv6
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network DYMONetwork
attr processid 1273
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-DynamicIPv6-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-DynamicIPv6-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 22s
config extends _Dynamic,_IPv6
config description "some nodes are shut down and restarted trigger route changes"
config *.host[*].hasStatus true
config *.host[0].status.initialStatus "\"down\""
config *.scenarioManager.script "xmldoc(\"scenario.xml\")"
config **.host[*].hasIpv6 true
config **.dymo.networkProtocolModule "\"^.ipv6.ipv6\""
config **.dymo.routingTableModule "\"^.ipv6.routingTable\""
config **.host[0].app[0].destAddr "\"host[1](ipv6)\""
config **.ipv6.configurator.networkConfiguratorModule "\"ipv6Configurator\""
config *.ipv6Configurator.config "xml(\"<config><interface hosts='*' names='wlan*' maxRtrAdvInterval='0.07' minRtrAdvInterval='0.03'/></config>\")"
config network DYMONetwork
config *.numHosts 20
config num-rngs 3
config **.mobility.rng-0 1
config **.wlan[*].mac.rng-0 2
config **.host[*].mobility.typename StationaryMobility
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.mobility.constraintAreaMinX 0m
config **.mobility.constraintAreaMinY 0m
config **.mobility.constraintAreaMaxX 600m
config **.mobility.constraintAreaMaxY 600m
config *.host[0].numApps 1
config *.host[0].app[*].typename PingApp
config *.host[0].app[0].startTime uniform(1s,5s)
config *.host[0].app[0].printPing true
config **.wlan[*].bitrate 2Mbps
config **.wlan[*].mac.dcf.channelAccess.pendingQueue.packetCapacity 14
config **.wlan[*].mac.dcf.channelAccess.cwMin 7
config **.wlan[*].radio.transmitter.power 2mW

