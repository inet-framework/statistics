version 3
run PPP-0-20261028-08:33:27-1268
attr configname PPP
attr datetime 20261028-08:33:27
attr datetimef 20261028-083327
attr experiment PPP
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network NClientsPPP
attr processid 1268
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-PPP-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-PPP-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1000s
config description "TCP apps via IPv6 over PPP network"
config extends "TCP_APP, PPP_net"
config **.cli[*].numApps 1
config **.cli[*].app[*].typename TelnetApp
config **.cli[*].app[0].localAddress "\"\""
config **.cli[*].app[0].localPort -1
config **.cli[*].app[0].connectAddress "\"srv\""
config **.cli[*].app[0].connectPort 1000
config **.cli[*].app[0].startTime uniform(10s,15s)
config **.cli[*].app[0].numCommands int(exponential(10))
config **.cli[*].app[0].commandLength intWithUnit(exponential(10B))
config **.cli[*].app[0].keyPressDelay exponential(0.1s)
config **.cli[*].app[0].commandOutputLength intWithUnit(exponential(40B))
config **.cli[*].app[0].thinkTime truncnormal(2s,3s)
config **.cli[*].app[0].idleInterval truncnormal(3600s,1200s)
config **.cli[*].app[0].reconnectInterval 30s
config **.srv.numApps 1
config **.srv.app[*].typename TcpGenericServerApp
config **.srv.app[0].localAddress "\"\""
config **.srv.app[0].localPort 1000
config **.srv.app[0].replyDelay 0s
config network NClientsPPP
config **.ppp[*].queue.typename DropTailQueue
config **.ppp[*].queue.packetCapacity 10
config *.n 4

