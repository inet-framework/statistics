version 3
run ETH-0-20261014-15:46:30-2782
attr configname ETH
attr datetime 20261014-15:46:30
attr datetimef 20261014-154630
attr experiment ETH
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network NClientsEth
attr processid 2782
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
