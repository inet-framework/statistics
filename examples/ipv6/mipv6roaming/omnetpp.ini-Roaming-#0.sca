config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Roaming-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Roaming-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 70s
config description "A mobile node roams across three access networks, handing over twice"
config *.CN[0].numApps 1
config *.CN[0].app[0].destAddr "\"2001:db8:0:2:8aa:ff:fe00:b\""
config *.CN[0].app[0].sendInterval 0.5s
config *.CN[0].app[0].startTime 1s
config network Mipv6RoamingNetwork
config seed-set 1
config num-rngs 3
config **.mobility.rng-0 2
config *.total_mn 1
config *.total_cn 1
config **.neighbourDiscovery.minIntervalBetweenRAs 3s
config **.neighbourDiscovery.maxIntervalBetweenRAs 7s
config *.radioMedium.mediumLimitCache.maxTransmissionPower 2.0mW
config *.radioMedium.mediumLimitCache.minReceptionPower -82dBm
config *.radioMedium.mediumLimitCache.minInterferencePower -82dBm
config **.AP*.wlan*.mgmt.beaconInterval 0.1s
config **.AP_Home.wlan*.mgmt.ssid "\"HOME\""
config **.AP_Home.wlan*.address "\"10:AA:00:00:00:01\""
config **.AP_Home.eth[0].address "\"10:AE:00:00:00:02\""
config **.AP_1.wlan*.mgmt.ssid "\"AP1\""
config **.AP_1.wlan*.address "\"10:AA:00:00:A1:01\""
config **.AP_1.eth[0].address "\"10:AE:00:00:A1:02\""
config **.AP_2.wlan*.mgmt.ssid "\"AP2\""
config **.AP_2.wlan*.address "\"10:AA:00:00:A2:01\""
config **.AP_2.eth[0].address "\"10:AE:00:00:A2:02\""
config **.AP_Home.wlan*.radio.channelNumber 1
config **.AP_1.wlan*.radio.channelNumber 2
config **.AP_2.wlan*.radio.channelNumber 3
config **.wlan*.agent.channelsToScan "\"1 2 3\""
config **.wlan*.agent.probeDelay 0.1s
config **.wlan*.agent.minChannelTime 0.15s
config **.wlan*.agent.maxChannelTime 0.3s
config **.wlan*.agent.authenticationTimeout 5s
config **.wlan*.agent.associationTimeout 5s
config **.wlan*.bitrate 2Mbps
config **.wlan*.mac.dcf.channelAccess.cwMin 7
config **.radio.transmitter.power 2.0mW
config **.analogModel.ignorePartialInterference true
config **.MN[0].mobility.typename TurtleMobility
config **.MN[0].mobility.turtleScript "xmldoc(\"movement.xml\")"
config **.MN*.mobility.updateInterval 0.1s
config **.mobility.constraintAreaMinZ 0m
config **.mobility.constraintAreaMaxZ 0m
config **.constraintAreaMaxX 1050m
config **.constraintAreaMaxY 850m
config *.MN[*].displayStringTextFormat "\"AP: {.wlan[0].mib.ssid}\\n{.ipv6.mipv6.mobilityStatus}\""
config **.app[*].typename PingApp
config **.app[*].packetSize 56B
config **.app[*].hopLimit 32
config **.forwarding false
config **.eth[*].queue.typename EthernetQosQueue
config **.eth[*].queue.dataQueue.typename DropTailQueue
config **.eth[*].queue.dataQueue.packetCapacity 10

