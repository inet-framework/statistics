config network Mipv6RoamingNetwork
config seed-set 1
config num-rngs 3
config **.mobility.rng-0 2
config *.total_mn 1
config *.total_cn 1
config **.neighbourDiscovery.minIntervalBetweenRAs 3s
config **.neighbourDiscovery.maxIntervalBetweenRAs 7s
config *.radioMedium.mediumLimitCache.maxTransmissionPower 2.0mW
config *.radioMedium.mediumLimitCache.minReceptionPower -82dBm
config *.radioMedium.mediumLimitCache.minInterferencePower -82dBm
config **.AP*.wlan*.mgmt.beaconInterval 0.1s
config **.AP_Home.wlan*.mgmt.ssid "\"HOME\""
config **.AP_Home.wlan*.address "\"10:AA:00:00:00:01\""
config **.AP_Home.eth[0].address "\"10:AE:00:00:00:02\""
