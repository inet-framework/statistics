config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-CustomRA-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-CustomRA-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 120s
config description "Custom RA/NDP parameters via XML attributes"
config **.configurator.assignAddressesToHosts false
config **.configurator.config "xml(\"<config>     <interface among='host1 host2 router1' prefix='2001:db8:1:x::/64'               advValidLifetime='86400' advPreferredLifetime='3600'               maxRtrAdvInterval='30' minRtrAdvInterval='10'/>     <interface among='host3 host4 router2' prefix='2001:db8:2:x::/64'               advValidLifetime='86400' advPreferredLifetime='3600'               maxRtrAdvInterval='30' minRtrAdvInterval='10'/>     <interface among='router1 router2' prefix='2001:db8:ff:x::/64'/> </config>\")"
config network Ipv6ConfiguratorNetwork
config **.ipv6.configurator.networkConfiguratorModule "\"configurator\""
config **.configurator.dumpAddresses true
config **.configurator.dumpRoutes true
config **.configurator.dumpLinks true
config **.host1.numApps 1
config **.host1.app[0].typename UdpBasicApp
config **.host1.app[0].destAddresses "\"host3\""
config **.host1.app[0].destPort 5000
config **.host1.app[0].messageLength 1000B
config **.host1.app[0].sendInterval 1s
config **.host1.app[0].startTime 5s
