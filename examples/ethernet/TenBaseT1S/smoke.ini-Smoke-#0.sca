version 3
run Smoke-0-20261027-15:37:53-1171
attr configname Smoke
attr datetime 20261027-15:37:53
attr datetimef 20261027-153753
attr experiment Smoke
attr inifile smoke.ini
attr iterationvars $numNodes=1
attr iterationvarsd numNodes=1
attr iterationvarsf numNodes=1-
attr measurement $numNodes=1
attr network MultidropNetwork
attr processid 1171
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar numNodes 1
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/smoke.ini-Smoke-#0.sca
config output-scalar-precision 17
config output-vector-file results/smoke.ini-Smoke-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 100ms
config description "Wide range smoke test of an Ethernet 10BASE-T1S multidrop link"
config network MultidropNetwork
config repeat 100
config *.numNodes 1
config *.controller.typename EthernetPlcaHost
config *.node[*].typename EthernetPlcaHost
config *.*.eth[*].plca.max_bc "intuniform(0, 10)"
config *.*.eth[*].plca.delay_line_length "intuniform(0, 100)"
config *.node[*].numApps 2
config *.node[*].app[0].typename EthernetSourceApp
config *.node[*].app[0].io.interface "\"eth0\""
config *.node[*].app[0].io.remoteAddress "\"controller\""
config *.node[*].app[0].source.productionInterval "uniform(100us, 1000us)"
config *.node[*].app[0].source.initialProductionOffset "uniform(0us, 100us)"
config *.node[*].app[0].source.packetLength "intuniform(46B, 1500B)"
config *.node[*].app[1].typename EthernetSinkApp
config *.node[*].app[1].io.interface "\"eth0\""
config *.node[*].app[1].io.steal true
