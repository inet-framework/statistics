version 3
run Paper-0-20261027-15:37:53-1162
attr configname Paper
attr datetime 20261027-15:37:53
attr datetimef 20261027-153753
attr experiment Paper
attr inifile paper.ini
attr iterationvars "$numNodes=1, $meanProductionInterval=3"
attr iterationvarsd numNodes=1/meanProductionInterval=3
attr iterationvarsf numNodes=1,meanProductionInterval=3-
attr measurement "$numNodes=1, $meanProductionInterval=3"
attr network MultidropNetwork
attr processid 1162
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar meanProductionInterval 3
itervar numNodes 1
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/paper.ini-Paper-#0.sca
config output-scalar-precision 17
config output-vector-file results/paper.ini-Paper-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1s
config description "Reproducing the results of the paper titled Network Performance Evaluation of IEEE 802.3cg"
config network MultidropNetwork
config *.numNodes 1
config *.controller.typename EthernetPlcaHost
config *.node[*].typename EthernetPlcaHost
config *.node[*].numApps 1
config *.node[*].app[0].typename EthernetSourceApp
config *.node[*].app[0].io.interface "\"eth0\""
config *.node[*].app[0].io.remoteAddress "\"controller\""
config *.node[*].app[0].source.packetLength "intuniform(46B, 1500B)"
config *.node[*].app[0].source.productionInterval "poisson(3) * 1ms"
config *.controller.numApps 1
config *.controller.app[0].typename EthernetSinkApp
config *.controller.app[0].io.interface "\"eth0\""
config *.controller.app[0].io.localAddress "\"controller\""
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer.format "\"%N%\\\\%m\""

