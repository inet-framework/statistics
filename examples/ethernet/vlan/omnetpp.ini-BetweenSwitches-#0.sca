attr configname BetweenSwitches
attr datetime 20261117-12:03:33
attr datetimef 20261117-120333
attr experiment BetweenSwitches
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network VlanExample
attr processid 1200
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
