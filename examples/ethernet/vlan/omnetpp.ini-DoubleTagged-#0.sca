config record-eventlog false
config sim-time-limit 10ms
config description "customer VLAN 42 between host1 and host2, and service VLAN 81 between switch1 and switch2"
config extends AbstractVlan
config *.host*.bridging.vlanPolicy.typename VlanPolicyLayer
config *.host*.bridging.vlanPolicy.outboundMapper.mappedVlanIds "{\"eth0\" : {\"-1\" : 42}}"
