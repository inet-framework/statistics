attr configname VirtualInterface
attr datetime 20261117-12:03:33
attr datetimef 20261117-120333
attr experiment VirtualInterface
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network VlanExample
