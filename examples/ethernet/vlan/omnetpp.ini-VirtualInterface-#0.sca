version 3
run VirtualInterface-0-20261026-16:49:26-1901
attr configname VirtualInterface
attr datetime 20261026-16:49:26
attr datetimef 20261026-164926
attr experiment VirtualInterface
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network VlanExample
attr processid 1901
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-VirtualInterface-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-VirtualInterface-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 10ms
config description "VLAN 42 between host1 and host2 using virtual interfaces"
config extends AbstractVlan
config *.configurator.config "xml(\"<config><interface hosts='**' address='10.x.x.x' netmask='255.x.x.x'/><route hosts='host1' destination='host2%virt0' netmask='255.255.255.255' interface='virt0'/><route hosts='host2' destination='host1%virt0' netmask='255.255.255.255' interface='virt0'/></config>\")"
config *.host1.app[*].connectAddress "\"host2%virt0\""
config *.host*.ieee8021q.hasSocketSupport true
config *.host*.numVirtInterfaces 1
config *.host*.virt[0].tunnel.realInterface "\"eth0\""
config *.host*.virt[0].tunnel.vlanId 42
config *.switch*.bridging.vlanPolicy.typename VlanPolicyLayer
config *.switch*.bridging.vlanPolicy.inboundFilter.acceptedVlanIds "{\"*\" : [42]}"
config *.switch*.bridging.vlanPolicy.outboundFilter.acceptedVlanIds "{\"*\" : [42]}"
config *.*.bridging.typename BridgingLayer
config *.*.bridging.macTableModule "\"\""
config *.switch*.bridging.directionReverser.reverser.forwardPcp false
config *.host*.bridging.directionReverser.typename ""
config *.host*.bridging.interfaceRelay.typename ""
config *.*.ieee8021q.typename Ieee8021qProtocol
config network VlanExample
config **.fcsMode "\"computed\""
config **.checksumMode "\"computed\""
config *.*.llc.typename ""
config *.*.ethernet.typename EthernetLayer
config *.*.eth[*].typename LayeredEthernetInterface
config *.*.eth[*].bitrate 100Mbps
config *.host1.numApps 1
config *.host1.app[*].typename TcpSessionApp
config *.host1.app[*].connectPort 1000
config *.host1.app[*].sendBytes 1MiB
config *.host1.app[*].tOpen 0s
config *.host1.app[*].tSend 0s
config *.host2.numApps 1
config *.host2.app[*].typename TcpEchoApp
config *.host2.app[0].localAddress "\"\""
config *.host2.app[0].localPort 1000
config *.*.numPcapRecorders 1
config *.host*.pcapRecorder[*].moduleNamePatterns "\"eth[0]\""
config *.host1.pcapRecorder[*].pcapFile "\"results/VirtualInterface-#0-host1_eth0.pcap\""
config *.host2.pcapRecorder[*].pcapFile "\"results/VirtualInterface-#0-host2_eth0.pcap\""
config *.switch*.pcapRecorder[*].moduleNamePatterns "\"eth[1]\""
config *.switch1.pcapRecorder[*].pcapFile "\"results/VirtualInterface-#0-switch1_eth1.pcap\""
config *.switch2.pcapRecorder[*].pcapFile "\"results/VirtualInterface-#0-switch2_eth1.pcap\""

