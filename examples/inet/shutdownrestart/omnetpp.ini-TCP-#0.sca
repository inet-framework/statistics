version 3
run TCP-0-20261026-16:51:13-2478
attr configname TCP
attr datetime 20261026-16:51:13
attr datetimef 20261026-165113
attr experiment TCP
attr inifile omnetpp.ini
attr iterationvars "$scenario=\"scenario_node.xml\""
attr iterationvarsd scenario=scenario#_node.xml
attr iterationvarsf scenario=scenario#_node.xml-
attr measurement "$scenario=\"scenario_node.xml\""
attr network NClients
attr processid 2478
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar scenario "\"scenario_node.xml\""
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-TCP-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-TCP-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 100s
config extends TCP_common
config **.cli[*].numApps 1
config **.cli[*].app[0].typename TelnetApp
config **.cli[*].app[0].localAddress "\"\""
config **.cli[*].app[0].localPort -1
config **.cli[*].app[0].connectAddress "\"srv\""
config **.cli[*].app[0].connectPort 1000
config **.cli[*].app[0].startTime exponential(3s)
config **.cli[*].app[0].numCommands int(exponential(10))
config **.cli[*].app[0].commandLength intWithUnit(exponential(10B))
config **.cli[*].app[0].keyPressDelay exponential(0.1s)
config **.cli[*].app[0].commandOutputLength intWithUnit(exponential(5B))
config **.cli[*].app[0].thinkTime truncnormal(1s,2s)
config **.cli[*].app[0].idleInterval truncnormal(36s,12s)
config **.cli[*].app[0].reconnectInterval 3s
config **.srv.numApps 1
config **.srv.app[0].typename TcpGenericServerApp
config **.srv.app[0].localAddress "\"\""
config **.srv.app[0].localPort 1000
config **.srv.app[0].replyDelay 0s
config network NClients
config *.n 2
config **.hasStatus true
config *.scenarioManager.script "xmldoc(\"scenario_node.xml\")"

