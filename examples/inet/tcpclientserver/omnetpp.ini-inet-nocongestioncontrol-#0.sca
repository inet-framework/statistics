version 3
run inet-nocongestioncontrol-0-20261014-15:46:03-2461
attr configname inet-nocongestioncontrol
attr datetime 20261014-15:46:03
attr datetimef 20261014-154603
attr experiment inet-nocongestioncontrol
attr inifile omnetpp.ini
attr iterationvars $0=0
attr iterationvarsd 0
attr iterationvarsf 0-
attr measurement $0=0
attr network ClientServer
attr processid 2461
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-inet-nocongestioncontrol-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-inet-nocongestioncontrol-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 500s
config description "inet_TCP <---> inet_TCP with TcpNoCongestionControl algorithm"
config *.server*.tcp.typename Tcp
config *.client*.tcp.typename Tcp
config **.tcp.tcpAlgorithmClass "\"TcpNoCongestionControl\""
config *.per "0.01 * 0"
config *.server*.app[0].echoFactor 0
config network ClientServer
config total-stack 7MiB
config **.server.numPcapRecorders 1
config **.server.pcapRecorder[0].pcapFile "\"results/server.pcap\""
config **.client1.numPcapRecorders 1
config **.client1.pcapRecorder[0].pcapFile "\"results/client1.pcap\""
config **.checksumMode "\"computed\""
config **.numApps 1
config **.client*.app[*].typename TcpSessionApp
config **.client*.app[0].active true
config **.client*.app[0].localPort -1
config **.client*.app[0].connectAddress "\"server\""
config **.client*.app[0].connectPort 1000
config **.client*.app[0].tOpen 0.2s
config **.client*.app[0].tSend 0.4s
config **.client*.app[0].sendBytes 1000000B
config **.client*.app[0].sendScript "\"\""
config **.client*.app[0].tClose 25s
config **.server*.app[*].typename TcpEchoApp
config **.server*.app[0].localPort 1000
config **.server*.app[0].echoDelay 0s
config **.ppp[*].queue.typename DropTailQueue
config **.ppp[*].queue.packetCapacity 10
config *.configurator.config "xml(\"<config><interface hosts='*' address='192.168.1.x' netmask='255.255.255.0'/></config>\")"

