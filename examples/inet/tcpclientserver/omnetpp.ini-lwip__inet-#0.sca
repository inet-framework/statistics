attr datetime 20261117-12:21:24
attr datetimef 20261117-122124
attr experiment lwip__inet
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network ClientServer
attr processid 1564
attr repetition 0
attr replication #0
attr resultdir results
