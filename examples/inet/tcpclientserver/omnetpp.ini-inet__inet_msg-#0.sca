config description "inet_TCP <---> inet_TCP"
config **.tcp.typename Tcp
config **.app[*].dataTransferMode "\"object\""
config **.server*.app[0].echoFactor 2.0
config network ClientServer
config total-stack 7MiB
config **.server.numPcapRecorders 1
