attr datetime 20261016-22:42:51
attr datetimef 20261016-224251
attr experiment Experiment
attr inifile omnetpp.ini
attr iterationvars "$linkDelay=1us, $advertisedWindowKiB=8, $tcpAlgorithm=\"Vegas\""
attr iterationvarsd linkDelay=1us/advertisedWindowKiB=8/tcpAlgorithm=Vegas
attr iterationvarsf linkDelay=1us,advertisedWindowKiB=8,tcpAlgorithm=Vegas-
