version 3
run Experiment-0-20261117-12:21:25-1618
attr configname Experiment
attr datetime 20261117-12:21:25
attr datetimef 20261117-122125
attr experiment Experiment
attr inifile omnetpp.ini
attr iterationvars "$linkDelay=1us, $advertisedWindowKiB=8, $tcpAlgorithm=\"Vegas\""
attr iterationvarsd linkDelay=1us/advertisedWindowKiB=8/tcpAlgorithm=Vegas
attr iterationvarsf linkDelay=1us,advertisedWindowKiB=8,tcpAlgorithm=Vegas-
attr measurement "$linkDelay=1us, $advertisedWindowKiB=8, $tcpAlgorithm=\"Vegas\""
attr network ClientServer
attr processid 1618
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar advertisedWindowKiB 8
itervar linkDelay 1us
itervar tcpAlgorithm "\"Vegas\""
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Experiment-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Experiment-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 240s
config **.channel.delay 1us
config **.advertisedWindow 8*1024
config **.windowScalingSupport true
config **.windowScalingFactor 6
config **.tcpAlgorithmClass "\"Tcp\"+\"Vegas\""
config network ClientServer
config **.numApps 1
config **.client*.app[*].typename TcpSessionApp
config **.client*.app[0].active true
config **.client*.app[0].localPort -1
config **.client*.app[0].connectAddress "\"server\""
config **.client*.app[0].connectPort 1000
config **.client*.app[0].tOpen 0.1s
config **.client*.app[0].tSend 1s
config **.client*.app[0].sendBytes 1GB
config **.client*.app[0].sendScript "\"\""
config **.server*.app[*].typename TcpEchoApp
config **.server*.app[0].localPort 1000
config **.server*.app[0].echoFactor 0
config **.ppp[*].queue.typename DropTailQueue
config **.ppp[*].queue.packetCapacity 10
config *.configurator.config "xml(\"<config><interface hosts='*' address='192.168.1.x' netmask='255.255.255.0'/></config>\")"

