version 3
run UDPTraffic6-0-20261028-08:34:30-1239
attr configname UDPTraffic6
attr datetime 20261028-08:34:30
attr datetimef 20261028-083430
attr experiment UDPTraffic6
attr inifile ipv6.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network TwoHosts6
attr processid 1239
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/ipv6.ini-UDPTraffic6-#0.sca
config output-scalar-precision 17
config output-vector-file results/ipv6.ini-UDPTraffic6-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 200s
config description "IPsec over IPv6 with UDP traffic"
config **.numApps 3
config **.client*.app[*].typename UdpBasicApp
config **.client*.app[0].localPort 1000
config **.client*.app[1].localPort 1001
config **.client*.app[2].localPort 1002
config **.client*.app[*].destAddresses "\"server\""
config **.client*.app[0].destPort 2000
config **.client*.app[1].destPort 2001
config **.client*.app[2].destPort 2002
config **.client*.app[*].startTime 1s
config **.client*.app[*].stopTime 5s
config **.client*.app[*].sendInterval 0.1s
config **.client*.app[*].messageLength 1024B
config **.server*.app[*].typename UdpSink
config **.server*.app[0].localPort 2000
config **.server*.app[1].localPort 2001
config **.server*.app[2].localPort 2002
config network TwoHosts6
config **.ppp[*].queueType "\"DropTailQueue\""
config **.ppp[*].queue.frameCapacity 10
config **.ipv6.configurator.networkConfiguratorModule "\"configurator\""
config **.client*.**.hasIpsec true
config **.server.**.hasIpsec true
config **.client1.**spdConfig "xmldoc(\"ipsecConfig.xml\", \"ipsecConfig/Devices/Device[@id='client1']/\")"
config **.server.**spdConfig "xmldoc(\"ipsecConfig.xml\", \"ipsecConfig/Devices/Device[@id='server']/\")"
config **.ipsec.ahProtectOutDelay 7us
config **.ipsec.ahProtectInDelay 9us
config **.ipsec.espProtectOutDelay 7us
config **.ipsec.espProtectInDelay 9us

