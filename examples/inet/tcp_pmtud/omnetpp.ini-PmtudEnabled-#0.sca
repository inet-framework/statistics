config *.client.app[0].idleInterval 10s
config *.server.numApps 1
config *.server.app[0].typename TcpGenericServerApp
config *.server.app[0].localPort 1000
config **.ppp[*].queue.typename DropTailQueue
config **.ppp[*].queue.packetCapacity 50

