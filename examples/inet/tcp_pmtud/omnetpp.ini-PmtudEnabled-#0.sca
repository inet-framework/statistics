version 3
run PmtudEnabled-0-20261117-12:39:01-1250
attr configname PmtudEnabled
attr datetime 20261117-12:39:01
attr datetimef 20261117-123901
attr experiment PmtudEnabled
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network PmtudNet
attr processid 1250
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
