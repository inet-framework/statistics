version 3
run PmtudEnabled-0-20261117-12:21:21-1460
attr configname PmtudEnabled
attr datetime 20261117-12:21:21
attr datetimef 20261117-122121
attr experiment PmtudEnabled
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network PmtudNet
attr processid 1460
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
