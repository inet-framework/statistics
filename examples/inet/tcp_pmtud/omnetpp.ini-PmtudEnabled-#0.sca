config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-PmtudEnabled-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-PmtudEnabled-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 300s
config description "PMTUD enabled: MSS reduced after ICMP Fragmentation Needed"
config **.tcp.pmtudEnabled true
config network PmtudNet
config *.router1.ppp[1].ppp.mtu 800B
config *.router2.ppp[0].ppp.mtu 800B
config **.tcp.typename Tcp
config **.tcp.mss 1460
config **.checksumMode "\"computed\""
config *.client.numApps 1
config *.client.app[0].typename TcpBasicClientApp
config *.client.app[0].connectAddress "\"server\""
