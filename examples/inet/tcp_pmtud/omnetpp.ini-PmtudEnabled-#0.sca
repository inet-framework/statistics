run PmtudEnabled-0-20261117-14:06:13-1301
attr configname PmtudEnabled
attr datetime 20261117-14:06:13
attr datetimef 20261117-140613
attr experiment PmtudEnabled
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network PmtudNet
attr processid 1301
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
