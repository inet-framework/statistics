config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-PmtudProbe-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-PmtudProbe-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 300s
config extends PmtudEnabled
config description "PMTUD with short timeout: demonstrates MSS increase probe and re-reduction"
config **.tcp.pmtudTimeout 30s
config **.tcp.pmtudEnabled true
config network PmtudNet
config *.router1.ppp[1].ppp.mtu 800B
config *.router2.ppp[0].ppp.mtu 800B
config **.tcp.typename Tcp
config **.tcp.mss 1460
config **.checksumMode "\"computed\""
config *.client.numApps 1
config *.client.app[0].typename TcpBasicClientApp
config *.client.app[0].connectAddress "\"server\""
config *.client.app[0].connectPort 1000
config *.client.app[0].startTime 1s
config *.client.app[0].numRequestsPerSession 10
config *.client.app[0].requestLength 100B
config *.client.app[0].replyLength 10000B
config *.client.app[0].thinkTime 5s
config *.client.app[0].idleInterval 10s
config *.server.numApps 1
config *.server.app[0].typename TcpGenericServerApp
config *.server.app[0].localPort 1000
config **.ppp[*].queue.typename DropTailQueue
config **.ppp[*].queue.packetCapacity 50

