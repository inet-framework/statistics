attr datetimef 20261117-125542
attr experiment PmtudProbe
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network PmtudNet
attr processid 1453
attr repetition 0
attr replication #0
