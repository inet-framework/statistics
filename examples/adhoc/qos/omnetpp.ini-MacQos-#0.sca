config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-MacQos-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 5s
config extends MacNonQos
config **.wlan[*].classifier.typename ExampleQosClassifier
