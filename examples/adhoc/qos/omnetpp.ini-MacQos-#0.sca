version 3
run MacQos-0-20261117-19:23:11-1198
attr configname MacQos
attr datetime 20261117-19:23:11
attr datetimef 20261117-192311
attr experiment MacQos
attr inifile omnetpp.ini
attr iterationvars $0=false
attr iterationvarsd false
attr iterationvarsf false-
attr measurement $0=false
attr network QosThroughput
attr processid 1198
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-MacQos-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-MacQos-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 5s
config description "This QoS example optionally uses historical Basic Block Ack from IEEE 802.11e-2005, which IEEE 802.11-2024 does not support."
config extends MacNonQos
config **.wlan[*].classifier.typename ExampleQosClassifier
config **.mac.hcf.edca.edcaf[*].pendingQueue.packetCapacity -1
config **.mac.qosStation true
config **.mac.hcf.isBlockAckSupported false
config *.cliHost.wlan[*].mac.hcf.blockAckVariant "\"basic\""
config *.srvHost.wlan[*].mac.hcf.blockAckVariant "\"basic\""
config **.cliHost.numApps 5
config **.cliHost.app[*].messageLength 1000B
config **.cliHost.app[*].sendInterval 0.0001s
config **.cliHost.app[0].destPort 21
config **.cliHost.app[1].destPort 80
config **.cliHost.app[2].destPort 4000
config **.cliHost.app[3].destPort 5000
config **.cliHost.app[4].destPort 99
config **.cliHost.app[0].packetName "\"FTP\""
config **.cliHost.app[1].packetName "\"WWW\""
config **.cliHost.app[2].packetName "\"Video\""
config **.cliHost.app[3].packetName "\"Voice\""
config **.cliHost.app[4].packetName "\"nonQos\""
config **.wlan[*].mac.typename Ieee80211Mac
config **.mac.dcf.channelAccess.pendingQueue.packetCapacity -1
config network QosThroughput
config **.arp.typename GlobalArp
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 400m
config **.constraintAreaMaxY 400m
config **.constraintAreaMaxZ 0m
config **.mobility.initFromDisplayString false
config **.cliHost.mobility.initialX 100m
config **.cliHost.mobility.initialY 100m
config **.srvHost.mobility.initialX 300m
config **.srvHost.mobility.initialY 100m
config **.mobility.initialZ 0m
config **.radio.transmitter.power 1000mW
config **.cliHost.app[*].typename UdpBasicApp
config **.cliHost.app[*].destAddresses "\"srvHost\""
config **.cliHost.app[*].startTime 0.5s
config **.cliHost.app[*].stopTime 5.0s
config **.srvHost.numApps 5
config **.srvHost.app[*].typename UdpSink
config **.srvHost.app[0].localPort 21
config **.srvHost.app[1].localPort 80
config **.srvHost.app[2].localPort 4000
config **.srvHost.app[3].localPort 5000
config **.srvHost.app[4].localPort 99

