config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Ping1-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Ping1-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 100s
config description "host1 pinging host0"
config *.numHosts 2
config *.host[0].wlan[*].radio.transmitter.analogModel.communicationRange 250m
config *.host[1].wlan[*].radio.transmitter.analogModel.communicationRange 300m
config network Net
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 600m
config **.constraintAreaMaxY 400m
config **.constraintAreaMaxZ 0m
config **.host*.mobility.typename MassMobility
config **.host*.mobility.initFromDisplayString false
config **.host*.mobility.changeInterval "truncnormal(2s, 0.5s)"
config **.host*.mobility.angleDelta "normal(0deg, 30deg)"
config **.host*.mobility.speed "truncnormal(20mps, 8mps)"
config **.host*.mobility.updateInterval 100ms
config *.host[0].numApps 0
config *.host[*].numApps 2
config *.host[*].app[*].typename PingApp
config *.host[*].app[*].destAddr "\"host[0]\""
config **.app[0].startTime uniform(1s,5s)
config **.app[1].startTime 5s+uniform(1s,5s)
config **.app[*].printPing true
config **.wlan[*].typename AckingWirelessInterface
config **.wlan[*].bitrate 2Mbps
config **.wlan[*].mac.headerLength 23B
config **.wlan[*].radio.typename GenericRadio
config **.wlan[*].radio.signalAnalogRepresentation "\"unitDisk\""
config **.wlan[*].radio.transmitter.bitrate 2Mbps
config **.wlan[*].radio.transmitter.headerLength 96b
config **.wlan[*].radio.transmitter.analogModel.interferenceRange 0m
config **.wlan[*].radio.transmitter.analogModel.detectionRange 0m
config **.wlan[*].radio.receiver.ignoreInterference true

