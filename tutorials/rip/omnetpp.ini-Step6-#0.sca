config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Step6-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Step6-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 500s
config description "Count to infinity (two-node loop instability)"
config network RipNetworkB
config *.configurator.config "xml(\"<config>                                 <interface hosts='**' address='10.x.x.x' netmask='255.x.x.x'/>                                 <autoroute sourceHosts='host*'/>                              </config>\")"
config *.configurator.addStaticRoutes true
config *.router*.hasRip true
config *.router*.rip.startupTime uniform(0s,1s)
config *.router*.rip.ripConfig "xml(\"<config> <interface hosts='router*' mode='NoSplitHorizon' /> </config>\")"
config *.router*.rip.triggeredUpdate false
config *.scenarioManager.script "xml(\"<scenario>                                     <disconnect t='50' src-module='router1' dest-module='switch1' />                                 </scenario>\")"
config *.visualizer.interfaceTableVisualizer[0].displayInterfaceTables true
config *.visualizer.routingTableVisualizer[*].nodeFilter "\"router* or host0 or host3\""
config *.visualizer.routingTableVisualizer[0].destinationFilter "\"host0\""
config *.visualizer.routingTableVisualizer[1].destinationFilter "\"host3\""
config **.arp.typename GlobalArp
config *.visualizer.typename IntegratedMultiCanvasVisualizer
config *.visualizer.numRoutingTableVisualizers 2
config *.visualizer.routingTableVisualizer[*].displayRoutingTables true
config *.visualizer.routingTableVisualizer[*].labelFormat "\"%d/%m (%e) -> %g (%n)\""
config *.visualizer.routingTableVisualizer[0].lineColor "\"red\""
config *.visualizer.routingTableVisualizer[1].lineColor "\"blue\""
config *.visualizer.interfaceTableVisualizer[0].nodeFilter "\"not switch*\""

