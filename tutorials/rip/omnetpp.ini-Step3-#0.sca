attr datetimef 20261027-082900
attr experiment Step3
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network RipNetworkA
attr processid 1195
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
