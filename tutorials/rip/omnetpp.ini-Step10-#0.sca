version 3
run Step10-0-20261026-16:55:04-7120
attr configname Step10
attr datetime 20261026-16:55:04
attr datetimef 20261026-165504
attr experiment Step10
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network RipNetworkA
attr processid 7120
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Step10-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Step10-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 100s
config description "Configure an interface as NoRIP"
config extends Step2
config *.router0.rip.ripConfig "xml(\"<config>                                 <interface names='eth[0]' mode='NoRIP' />                                 <interface metric='1' />                             </config>\")"
config *.router2.rip.ripConfig "xml(\"<config>                                 <interface names='eth[1]' mode='NoRIP' />                                 <interface metric='1' />                             </config>\")"
config network RipNetworkA
config *.configurator.config "xml(\"<config>                                 <interface hosts='**' address='10.x.x.x' netmask='255.x.x.x'/>                                 <autoroute sourceHosts='host*'/>                              </config>\")"
config *.configurator.addStaticRoutes true
config *.router*.hasRip true
config *.router*.rip.startupTime uniform(0s,1s)
config *.router*.rip.ripConfig "xml(\"<config>                                   <interface hosts='router*' mode='NoSplitHorizon' />                                </config>\")"
config *.router*.rip.triggeredUpdate false
config *.host0.numApps 1
config *.host0.app[0].typename PingApp
config *.host0.app[0].destAddr "\"host6\""
config *.host0.app[0].startTime 50s
config *.*.ipv4.arp.typename GlobalArp
config *.visualizer.interfaceTableVisualizer[0].displayInterfaceTables true
config *.visualizer.typename IntegratedMultiCanvasVisualizer
config *.visualizer.numRoutingTableVisualizers 2
config *.visualizer.routingTableVisualizer[*].displayRoutingTables true
config *.visualizer.routingTableVisualizer[*].nodeFilter "\"router* or host0 or host6\""
config *.visualizer.routingTableVisualizer[*].labelFormat "\"%d/%m (%e) -> %g (%n)\""
config *.visualizer.routingTableVisualizer[0].destinationFilter "\"host0\""
config *.visualizer.routingTableVisualizer[0].lineColor "\"red\""
config *.visualizer.routingTableVisualizer[1].destinationFilter "\"host6\""
config *.visualizer.routingTableVisualizer[1].lineColor "\"blue\""
config *.visualizer.interfaceTableVisualizer[0].nodeFilter "\"not switch*\""

