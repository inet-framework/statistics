config description "Setting all router ids to zero"
config extends Step6
config *.R*.ospf.ospfConfig "xmldoc(\"ASConfig_zero_priority.xml\")"
config *.visualizer.routingTableVisualizer.destinationFilter "\"R*\""
config *.visualizer.routingTableVisualizer.nodeFilter "\"R* and not *.N*\""
config network Network2
config *.configurator.config "xml(\"<config>                                 <interface hosts='**' address='10.x.x.x' netmask='255.255.255.x'/>                                 <route hosts='host*' destination='*' netmask='0.0.0.0' interface='eth0' />                              </config>\")"
config *.host0.numApps 1
config *.host0.app[0].typename PingApp
config *.host0.app[0].destAddr "\"host6\""
