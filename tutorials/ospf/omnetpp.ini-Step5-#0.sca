config description "Effect of network type of an interface on routing table routes"
config network InterfaceNetworkType
config *.configurator.configureIsolatedNetworksSeparatly true
config *.configurator.config "xml(\"<config>                                 <interface hosts='**' address='10.x.x.x' netmask='255.x.x.x'/>                                 <route hosts='host*' destination='*' netmask='0.0.0.0' interface='eth0' />                              </config>\")"
