config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Step4a-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Step4a-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1000s
config description "Advertising loopback interface"
config network RouterLSA
config *.configurator.config "xml(\"<config>                                 <interface hosts='**' address='10.x.x.x' netmask='255.x.x.x'/>                                 <route hosts='host*' destination='*' netmask='0.0.0.0' interface='eth0' />                              </config>\")"
config *.R*.ospf.ospfConfig "xmldoc(\"ASConfig_Loopback.xml\")"
config *.R1.numLoInterfaces 2
config *.host0.numApps 1
config *.host0.app[0].typename PingApp
config *.host0.app[0].destAddr "\"host6\""
config *.host0.app[0].startTime 60s
config **.ospf.cmdenv-log-level trace
config **.cmdenv-log-level off
config *.pcapRecorder.moduleNamePatterns "\".^\""
config *.pcapRecorder.pcapFile "\"results/Step4a-0.pcap\""
config **.checksumMode "\"computed\""
config **.fcsMode "\"computed\""
config *.*.ospf.displayStringTextFormat "\"routerID: {routerID}\\n{interfaces}\""
config *.R*.hasOspf true
config *.configurator.addStaticRoutes false
config *.visualizer.interfaceTableVisualizer[0].displayInterfaceTables true
config **.visualizer.interfaceTableVisualizer.nodeFilter "\"not fullPath =~ *.N**\""
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.numRoutingTableVisualizers 2
config *.visualizer.routingTableVisualizer[*].displayRoutingTables true
config *.visualizer.routingTableVisualizer[0].destinationFilter "\"host6\""
config *.visualizer.routingTableVisualizer[1].destinationFilter "\"host0\""
config *.visualizer.routingTableVisualizer[*].nodeFilter "\"R* and not(N*)\""
config *.visualizer.routingTableVisualizer[0].lineColor "\"blue\""
config *.visualizer.routingTableVisualizer[1].lineColor "\"red\""
config *.visualizer.routingTableVisualizer[*].labelFormat "\"%d/%m (%e) -> %g (%n)\""
config *.visualizer.routingTableVisualizer[*].lineStyle "\"dashed\""
config *.visualizer**.infoVisualizer.displayInfos true
config *.visualizer**.infoVisualizer.modules "\"**ospf\""
config *.visualizer.networkRouteVisualizer[*].displayRoutes true
config *.visualizer.networkRouteVisualizer[*].packetFilter "\"ping* or Udp*\""
config *.visualizer.networkRouteVisualizer.displayRoutes true
config *.visualizer.networkRouteVisualizer.packetFilter "\"ping* or Udp*\""

