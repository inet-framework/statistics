config *.visualizer**.infoVisualizer.displayInfos true
config *.visualizer**.infoVisualizer.modules "\"**ospf\""
config *.visualizer.networkRouteVisualizer[*].displayRoutes true
config *.visualizer.networkRouteVisualizer[*].packetFilter "\"ping* or Udp*\""
