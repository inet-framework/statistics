config **.ospf.cmdenv-log-level trace
config **.cmdenv-log-level off
config *.pcapRecorder.moduleNamePatterns "\".^\""
config *.pcapRecorder.pcapFile "\"results/Step10a-0.pcap\""
config **.checksumMode "\"computed\""
config **.fcsMode "\"computed\""
config *.*.ospf.displayStringTextFormat "\"routerID: {routerID}\\n{interfaces}\""
config *.R*.hasOspf true
config *.configurator.addStaticRoutes false
config *.visualizer.interfaceTableVisualizer[0].displayInterfaceTables true
config **.visualizer.interfaceTableVisualizer.nodeFilter "\"not fullPath =~ *.N**\""
