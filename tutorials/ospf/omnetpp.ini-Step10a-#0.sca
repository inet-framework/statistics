config record-eventlog false
config sim-time-limit 1000s
config description "Router R4 goes down"
config extends Step10
config *.scenarioManager.script "xml(\"<scenario> <at t='60'> <shutdown module='R4'/> </at> </scenario>\")"
config network TopologyChange
config *.R*.ospf.ospfConfig "xmldoc(\"ASConfig_tp_priority.xml\")"
config *.visualizer.routingTableVisualizer.displayRoutingTables true
config *.visualizer.routingTableVisualizer.destinationFilter "\"*\""
config *.visualizer.routingTableVisualizer.nodeFilter "\"R*\""
config *.*.hasStatus true
config *.R3.numApps 1
config *.R3.app[0].typename PingApp
config *.R3.app[0].destAddr "\"R1\""
