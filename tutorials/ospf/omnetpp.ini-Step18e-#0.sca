config *.configurator.config "xml(\"<config>                                 <interface hosts='R3' towards='R4' address='192.168.0.x' netmask='255.255.255.x' />                                 <interface hosts='R4' towards='R3' address='192.168.0.x' netmask='255.255.255.x' />                                                                 <interface among='host1 host2 R1 R2 R3' address='192.168.11.x' netmask='255.255.255.x' />                                 <interface among='R3 R4 R5 R6 host3' address='192.168.22.x' netmask='255.255.255.x' />                                                                 <route hosts='host*' destination='*' netmask='0.0.0.0' interface='eth0' />                                 <route hosts='R6' destination='*' netmask='0.0.0.0' interface='eth0' gateway='192.168.22.1' />                              </config>\")"
config *.R6.hasOspf false
config *.R*.ospf.ospfConfig "xmldoc(\"ASConfig_Area_ExternalRoute_Forwarding.xml\")"
config *.host1.numApps 1
