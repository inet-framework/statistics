config network RegressionTestingTutorialWired
config **.arp.typename GlobalArp
config *.server.numApps 1
config *.server.app[0].typename UdpVideoStreamServer
config *.server.app[0].localPort 1001
config *.server.app[0].packetLen 1000Byte
config *.server.app[0].videoSize 1MiB
