config *.visualizer.numNetworkRouteVisualizers 2
config *.visualizer.infoVisualizer[*].displayInfos true
config *.visualizer.infoVisualizer[*].modules "\"*.host2.udp or *.host4.udp\""
config *.visualizer.infoVisualizer[*].format "\"%t\""
