version 3
run Step8B-0-20260916-13:05:51-6019
attr configname Step8B
attr datetime 20260916-13:05:51
attr datetimef 20260916-130551
attr experiment Step8B
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network ConfiguratorC
attr processid 6019
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Step8B-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Step8B-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 100s
config extends Step8A
config description "Mixed wired/wireless network configuration - using SSID"
config *.configurator.config "xmldoc(\"step8b.xml\")"
config *.area1AP.wlan[*].mgmt.ssid "\"area1\""
config *.area3AP.wlan[*].mgmt.ssid "\"area3\""
config *.area1lan3*.wlan[*].agent.defaultSsid "\"area1\""
config *.area3lan3*.wlan[*].agent.defaultSsid "\"area3\""
config network ConfiguratorC
config *.area1lan3host2.numApps 1
config *.area1lan3host2.app[0].typename PingApp
config *.area1lan3host2.app[*].destAddr "\"area3lan3host2\""
config *.*.wlan[*].bitrate 54Mbps
config *.visualizer.routingTableVisualizer.displayRoutingTables true
config *.visualizer.routingTableVisualizer.destinationFilter "\"area3lan3*\""
config *.visualizer.routingTableVisualizer.lineShift 0
config *.configurator.dumpAddresses true
config *.configurator.dumpTopology true
config *.configurator.dumpLinks true
config *.configurator.dumpRoutes true
config *.*.ipv4.arp.typename GlobalArp
config *.*.ipv4.routingTable.netmaskRoutes "\"\""
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer.nodeFilter "\"not (*switch* or *Switch* or *AP*)\""

