config *.area1AP.wlan[*].mgmt.ssid "\"area1lan3\""
config *.area3AP.wlan[*].mgmt.ssid "\"area3lan3\""
config *.area1lan3host*.wlan[*].agent.defaultSsid "\"area1lan3\""
config *.area3lan3host*.wlan[*].agent.defaultSsid "\"area3lan3\""
