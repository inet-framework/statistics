config *.configurator.config "xml(\"<config>                                 <interface hosts='RA4' names='eth0' address='192.168.x.x' netmask='255.x.x.x'/>                                 <interface hosts='RB1' names='eth2' address='192.168.x.x' netmask='255.x.x.x'/>                                 <interface hosts='RB4' names='eth2' address='192.168.x.x' netmask='255.x.x.x'/>                                 <interface hosts='RC1' names='eth2' address='192.168.x.x' netmask='255.x.x.x'/>                                                                 <interface among='host0 RA*' address='10.x.x.x' netmask='255.x.x.x'/>                                 <interface hosts='RA*' address='10.x.x.x' netmask='255.x.x.x'/>                                                                 <interface hosts='RB*' address='20.x.x.x' netmask='255.x.x.x'/>                                                                 <interface among='host1 RC*' address='30.x.x.x' netmask='255.x.x.x'/>                                 <interface hosts='RC*' address='30.x.x.x' netmask='255.x.x.x'/>                                                                 <route hosts='host*' destination='*' netmask='0.0.0.0' interface='eth0' />                                                                 <route hosts='RA4' destination='*' netmask='0.0.0.0' interface='eth0' />                                 <route hosts='RC1' destination='*' netmask='0.0.0.0' interface='eth2' />                              </config>\")"
