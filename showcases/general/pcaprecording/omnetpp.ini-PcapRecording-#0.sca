version 3
run PcapRecording-0-20261117-12:55:48-1665
attr configname PcapRecording
attr datetime 20261117-12:55:48
attr datetimef 20261117-125548
attr experiment PcapRecording
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network PcapRecordingShowcase
attr processid 1665
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-PcapRecording-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-PcapRecording-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 10s
config network PcapRecordingShowcase
config *.host1.numApps 1
config *.host1.app[0].typename UdpBasicApp
config *.host1.app[*].destAddresses "\"host2\""
config *.host1.app[*].destPort 1000
config *.host1.app[*].localPort 1000
config *.host1.app[*].messageLength 1000Byte
config *.host1.app[*].sendInterval 2ms
config *.host2.numApps 1
config *.host2.app[0].typename UdpSink
config *.host2.app[*].localPort 1000
config *.ethHost1.numApps 2
config *.ethHost1.app[0].typename TcpSessionApp
config *.ethHost1.app[0].dataTransferMode "\"bytestream\""
config *.ethHost1.app[0].connectAddress "\"ethHost2\""
config *.ethHost1.app[0].tOpen 10ms
config *.ethHost1.app[0].tSend 10ms
config *.ethHost1.app[1].typename PingApp
config *.ethHost1.app[1].destAddr "\"ethHost2\""
config *.ethHost1.app[1].startTime 0s
config *.ethHost1.app[1].sendInterval 5ms
config *.ethHost2.numApps 1
config *.ethHost2.app[0].typename TcpSinkApp
config **.checksumMode "\"computed\""
config **.fcsMode "\"computed\""
config *.host*.wlan[*].bitrate 54Mbps
config *.host1.numPcapRecorders 1
config *.host1.pcapRecorder[0].pcapFile "\"results/host1.80211.pcap\""
config *.host2.numPcapRecorders 1
config *.host2.pcapRecorder[0].pcapFile "\"results/host2.arp.pcap\""
config *.host2.pcapRecorder[0].packetFilter expr(has(ArpPacket))
config *.ethHost1.numPcapRecorders 1
config *.ethHost1.pcapRecorder[0].pcapFile "\"results/ethHost1.eth.pcap\""
config *.router1.numPcapRecorders 2
config *.router1.pcapRecorder[0].pcapFile "\"results/router1.ppp.pcap\""
config *.router1.pcapRecorder[0].moduleNamePatterns "\"ppp[0]\""
config *.router1.pcapRecorder[1].pcapFile "\"results/router1.eth.pcap\""
config *.router1.pcapRecorder[1].moduleNamePatterns "\"eth[0]\""
config *.router2.numPcapRecorders 1
config *.router2.pcapRecorder[0].moduleNamePatterns "\"eth[0]\""
config *.router2.pcapRecorder[0].pcapFile "\"results/router2.tcpdata.pcap\""
config *.router2.pcapRecorder[0].packetFilter "expr(has(TcpHeader) && has(Ipv4Header) && Ipv4Header.totalLengthField-Ipv4Header.headerLength-TcpHeader.headerLength > 0B)"
config *.ethHost2.numPcapRecorders 1
config *.ethHost2.pcapRecorder[0].pcapFile "\"results/ethHost2.ip.pcap\""
config *.ethHost2.pcapRecorder[0].dumpProtocols "\"ipv4\""
config **.pcapRecorder[*].alwaysFlush true
config *.visualizer.numDataLinkVisualizers 2
config *.visualizer.numInterfaceTableVisualizers 2
config *.visualizer.dataLinkVisualizer[0].displayLinks true
config *.visualizer.dataLinkVisualizer[0].packetFilter "\"not *ping*\""
config *.visualizer.physicalLinkVisualizer[*].displayLinks true
config *.visualizer.interfaceTableVisualizer[0].displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer[0].format "\"%N\""
config *.visualizer.interfaceTableVisualizer[1].displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer[1].format "\"%a\""
config *.visualizer.interfaceTableVisualizer[1].displayWiredInterfacesAtConnections false
config *.visualizer.transportConnectionVisualizer[*].displayTransportConnections true
config *.visualizer.dataLinkVisualizer[1].displayLinks true
config *.visualizer.dataLinkVisualizer[1].packetFilter "\"*ping*\""
config *.visualizer.dataLinkVisualizer[1].lineColor "\"red\""
config *.visualizer.infoVisualizer[*].modules "\"*.*.pcapRecorder[*]\""
config *.visualizer.infoVisualizer[*].format "\"%t\""

