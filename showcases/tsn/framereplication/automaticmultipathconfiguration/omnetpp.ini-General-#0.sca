config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-General-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-General-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 0.1s
config network AutomaticMultipathConfigurationShowcase
config description "Automatic multipath static stream redundancy configuration"
config *.macForwardingTableConfigurator.typename ""
config *.*.hasStatus true
config *.*.eth[*].bitrate 100Mbps
config *.*.hasStreamRedundancy true
config *.source.numApps 1
config *.source.app[0].typename UdpSourceApp
config *.source.app[0].io.destAddress "\"destination\""
config *.source.app[0].io.destPort 1000
config *.source.app[0].source.displayStringTextFormat "\"sent %p pk (%l)\""
config *.source.app[0].source.packetLength 1200B
config *.source.app[0].source.productionInterval 1ms
config *.destination.numApps 1
config *.destination.app[0].typename UdpSinkApp
config *.destination.app[0].io.localPort 1000
config *.scenarioManager.script "xml(\"<script>                                  <at t='20ms'><crash module='s2a'/></at>                                   <at t='80ms'><startup module='s2a'/></at>                                 </script>\")"
config *.destination.eth[*].address "\"0A-AA-12-34-56-78\""
config *.visualizer.infoVisualizer.modules "\"*.source.app[0].source or *.destination.app[0].sink\""
config *.streamRedundancyConfigurator.typename StreamRedundancyConfigurator
config *.streamRedundancyConfigurator.configuration "[{name: \"S1\", packetFilter: \"*\", source: \"source\", destination: \"destination\",\n                                                 trees: [[[\"source\", \"s1\", \"s2a\", \"s3a\", \"destination\"]],\n                                                         [[\"source\", \"s1\", \"s2b\", \"s3b\", \"destination\"]],\n                                                         [[\"source\", \"s1\", \"s2a\", \"s2b\", \"s3b\", \"destination\"]],\n                                                         [[\"source\", \"s1\", \"s2b\", \"s2a\", \"s3a\", \"destination\"]]]}]"
config *.visualizer.streamRedundancyConfigurationVisualizer.displayTrees true
config *.visualizer.streamRedundancyConfigurationVisualizer.lineColor "\"black\""

