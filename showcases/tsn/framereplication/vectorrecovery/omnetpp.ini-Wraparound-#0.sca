version 3
run Wraparound-0-20261120-14:54:35-1202
attr configname Wraparound
attr datetime 20261120-14:54:35
attr datetimef 20261120-145435
attr experiment Wraparound
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network inet.showcases.tsn.framereplication.manualconfiguration.ManualConfigurationShowcase
attr processid 1202
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Wraparound-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Wraparound-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 7s
config extends VectorRecovery
config description "70000 frames across a complete 16-bit sequence-number wrap"
config *.source.app[0].source.packetLength 64B
config *.source.app[0].source.productionInterval 100us
config *.source.app[0].source.packetLengths:vector.vector-recording true
config *.destination.app[0].sink.packetLifeTime:vector.vector-recording true
config **.vector-recording false
config network inet.showcases.tsn.framereplication.manualconfiguration.ManualConfigurationShowcase
config *.*.bridging.streamRelay.merger.typename VectorStreamMerger
config *.*.bridging.streamRelay.merger.historyLength 32
config *.*.bridging.streamRelay.merger.resetTimeout 10ms
config *.*.bridging.streamRelay.merger.ticksPerSecond 1000
config *.macForwardingTableConfigurator.typename ""
config *.*.hasStatus true
config *.*.eth[*].bitrate 100Mbps
config *.scenarioManager.script "xml(\"<script>                                  <at t='20ms'><crash module='s2a'/></at>                                   <at t='80ms'><startup module='s2a'/></at>                                 </script>\")"
config *.*.hasStreamRedundancy true
config *.source.numApps 1
config *.source.app[0].typename UdpSourceApp
config *.source.app[0].io.destAddress "\"destination\""
config *.source.app[0].io.destPort 1000
config *.source.app[0].source.displayStringTextFormat "\"sent %p pk (%l)\""
config *.destination.numApps 1
config *.destination.app[0].typename UdpSinkApp
config *.destination.app[0].io.localPort 1000
config *.destination.eth[*].address "\"0A-AA-12-34-56-78\""
config *.visualizer.infoVisualizer.modules "\"*.source.app[0].source or *.destination.app[0].sink\""
config *.source.bridging.streamIdentifier.identifier.mapping "[{packetFilter: \"*\", stream: \"s1\", sequenceNumbering: true}]"
config *.source.bridging.streamCoder.encoder.mapping "[{stream: \"s1\", vlan: 1}]"
config *.s1.ieee8021q.qTagHeaderChecker.vlanIdFilter [1]
config *.s1.bridging.streamCoder.decoder.mapping "[{interface: \"eth2\", vlan: 1, stream: \"s1\"}]"
config *.s1.bridging.streamRelay.splitter.mapping "{s1: [\"s2a\", \"s2b\"]}"
config *.s1.bridging.streamCoder.encoder.mapping "[{stream: \"s2a\", vlan: 1},\n                                             {stream: \"s2b\", vlan: 2}]"
config *.s1.macTable.forwardingTable "[{address: \"destination\", vlan: 1, interface: \"eth0\"},\n                                 {address: \"destination\", vlan: 2, interface: \"eth1\"}]"
config *.s2a.ieee8021q.qTagHeaderChecker.vlanIdFilter "[1, 2]"
config *.s2a.bridging.streamCoder.decoder.mapping "[{interface: \"eth2\", vlan: 1, stream: \"s2a\"},\n                                              {interface: \"eth1\", vlan: 2, stream: \"s2b-s2a\"}]"
config *.s2a.bridging.streamRelay.merger.mapping "{s2a: \"s3a\", \"s2b-s2a\": \"s3a\"}"
config *.s2a.bridging.streamRelay.splitter.mapping "{s3a: [\"s3a\", \"s2b\"]}"
config *.s2a.bridging.streamCoder.encoder.mapping "[{stream: \"s3a\", vlan: 1},\n                                              {stream: \"s2b\", vlan: 2}]"
config *.s2a.macTable.forwardingTable "[{address: \"destination\", vlan: 1, interface: \"eth0\"},\n                                  {address: \"destination\", vlan: 2, interface: \"eth1\"}]"
config *.s2b.ieee8021q.qTagHeaderChecker.vlanIdFilter "[1, 2]"
config *.s2b.bridging.streamCoder.decoder.mapping "[{interface: \"eth2\", vlan: 2, stream: \"s2b\"},\n                                              {interface: \"eth1\", vlan: 2, stream: \"s2a-s2b\"}]"
config *.s2b.bridging.streamRelay.merger.mapping "{s2b: \"s3b\", \"s2a-s2b\": \"s3b\"}"
config *.s2b.bridging.streamRelay.splitter.mapping "{s3b: [\"s3b\", \"s2a\"]}"
config *.s2b.bridging.streamCoder.encoder.mapping "[{stream: \"s3b\", vlan: 1},\n                                              {stream: \"s2a\", vlan: 2}]"
config *.s2b.macTable.forwardingTable "[{address: \"destination\", vlan: 1, interface: \"eth0\"},\n                                  {address: \"destination\", vlan: 2, interface: \"eth1\"}]"
config *.s3a.bridging.streamCoder.decoder.mapping "[{interface: \"eth1\", vlan: 1, stream: \"s3a\"}]"
config *.s3a.bridging.streamCoder.encoder.mapping "[{stream: \"s3a\", vlan: 1}]"
config *.s3a.ieee8021q.qTagHeaderChecker.vlanIdFilter [1]
config *.s3a.macTable.forwardingTable "[{address: \"destination\", vlan: 1, interface: \"eth0\"}]"
config *.s3b.bridging.streamCoder.decoder.mapping "[{interface: \"eth1\", vlan: 1, stream: \"s3b\"}]"
config *.s3b.bridging.streamCoder.encoder.mapping "[{stream: \"s3b\", vlan: 1}]"
config *.s3b.ieee8021q.qTagHeaderChecker.vlanIdFilter [1]
config *.s3b.macTable.forwardingTable "[{address: \"destination\", vlan: 1, interface: \"eth0\"}]"
config *.destination.ieee8021q.qTagHeaderChecker.vlanIdFilter [1]
config *.destination.bridging.streamCoder.decoder.mapping "[{interface: \"eth0\", vlan: 1, stream: \"s3a\"},\n                                                      {interface: \"eth1\", vlan: 1, stream: \"s3b\"}]"
config *.destination.bridging.streamRelay.merger.mapping "{s3a: \"\", s3b: \"\"}"

