config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/extras.ini-Recovery-#0.sca
config output-scalar-precision 17
config output-vector-file results/extras.ini-Recovery-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 4s
config extends Failover
config description "The primary master clock node fails at 2s; Failover to hot-standby master; recovery of primary master at 3s"
config *.scenarioManager.script "xml(\"<scenario>                                   <at t='2'>                                     <disconnect src-module='tsnClock1' src-gate='ethg[0]'/>                                   </at>                                   <at t='2'>                                     <set-param module='tsnSwitch1.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnSwitch2.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnSwitch3.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnSwitch4.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnSwitch5.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnSwitch6.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnDevice1.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnDevice2.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnDevice3.clock' par='activeClockIndex' value='2'/>                                     <set-param module='tsnDevice4.clock' par='activeClockIndex' value='2'/>                                   </at>                                   <at t='3'>                                     <connect src-module='tsnClock1' src-gate='ethg[0]' dest-module='tsnSwitch1' dest-gate='ethg[0]' channel-type='inet.node.ethernet.Eth100M'/>                                   </at>                                   <at t='3'>                                     <set-param module='tsnSwitch1.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnSwitch2.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnSwitch3.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnSwitch4.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnSwitch5.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnSwitch6.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnDevice1.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnDevice2.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnDevice3.clock' par='activeClockIndex' value='0'/>                                     <set-param module='tsnDevice4.clock' par='activeClockIndex' value='0'/>                                   </at>                                 </scenario>\")"
