version 3
run NoStreamFiltering-0-20261026-16:53:30-5207
attr configname NoStreamFiltering
attr datetime 20261026-16:53:30
attr datetimef 20261026-165330
attr experiment NoStreamFiltering
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network TokenBucketPolicingShowcaseNetwork
attr processid 5207
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-NoStreamFiltering-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-NoStreamFiltering-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1s
config description "misbehaving traffic increases end-to-end delay for normal traffic"
config network TokenBucketPolicingShowcaseNetwork
config *.*.eth[*].bitrate 100Mbps
config *.client*.numApps 1
config *.client*.app[*].typename UdpSourceApp
config *.client1.app[0].display-name "misbehaving traffic"
config *.client2.app[0].display-name "normal traffic"
config *.client*.app[*].io.destAddress "\"server\""
config *.client1.app[0].io.destPort 1000
config *.client2.app[0].io.destPort 1001
config *.client1.app[0].io.displayStringTextFormat "\"{numSent} misbehaving traffic\""
config *.client2.app[0].io.displayStringTextFormat "\"{numSent} normal traffic\""
config *.client1.app[0].source.packetLength 1000B
config *.client1.app[0].source.productionInterval "200us + replaceUnit(sin(dropUnit(simTime() * 10)), \"ms\") / 8"
config *.client2.app[0].source.packetLength 500B
config *.client2.app[0].source.productionInterval 250us
config *.server.numApps 2
config *.server.app[*].typename UdpSinkApp
config *.server.app[0].display-name "misbehaving traffic"
config *.server.app[1].display-name "normal traffic"
config *.server.app[0].io.localPort 1000
config *.server.app[1].io.localPort 1001
config *.server.app[0].io.displayStringTextFormat "\"{numReceived} misbehaving traffic\""
config *.server.app[1].io.displayStringTextFormat "\"{numReceived} normal traffic\""
config *.visualizer.infoVisualizer.displayInfos true
config *.visualizer.infoVisualizer.placementHint "\"top\""
config *.visualizer.infoVisualizer.modules "\"*.*.app[*].io or *.switch.eth[2].macLayer.queue\""
config *.visualizer.networkNodeVisualizer.annotationSpacing 12
config *.visualizer.packetDropVisualizer.displayPacketDrops true
config *.visualizer.packetDropVisualizer.nodeFilter "\"*switch*\""
config *.visualizer.packetDropVisualizer.fadeOutTime 3s
config *.visualizer.queueVisualizer.displayQueues true
config *.visualizer.queueVisualizer.queueFilter "\"**switch.eth[2]**\""
config *.visualizer.queueVisualizer.placementHint "\"topRight\""
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer.format "\"%N\""
config *.visualizer.interfaceTableVisualizer.nodeFilter "\"*switch*\""
config *.switch.eth[2].macLayer.queue.displayStringTextFormat "\"eth[2] queue:\\ncontains %p packets\""

