version 3
run StreamFiltering-0-20261014-13:08:37-4810
attr configname StreamFiltering
attr datetime 20261014-13:08:37
attr datetimef 20261014-130837
attr experiment StreamFiltering
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network StatisticalPolicingShowcaseNetwork
attr processid 4810
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-StreamFiltering-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-StreamFiltering-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1s
config description "Per-stream filtering using sliding window rate metering and statistical rate limiting"
config *.client*.hasOutgoingStreams true
config *.client*.bridging.streamIdentifier.identifier.mapping "[{stream: \"misbehaving traffic\", packetFilter: expr(udp.destPort == 1000)},\n                                                          {stream: \"normal traffic\", packetFilter: expr(udp.destPort == 1001)}]"
config *.client*.bridging.streamCoder.encoder.mapping "[{stream: \"misbehaving traffic\", vlan: 0},\n                                                  {stream: \"normal traffic\", vlan: 4}]"
config *.switch.bridging.directionReverser.reverser.excludeEncapsulationProtocols "[\"ieee8021qctag\"]"
config *.switch.bridging.streamCoder.decoder.mapping "[{vlan: 0, stream: \"misbehaving traffic\"},\n                                                 {vlan: 4, stream: \"normal traffic\"}]"
config *.switch.hasIngressTrafficFiltering true
config *.switch.bridging.streamFilter.ingress.numStreams 2
config *.switch.bridging.streamFilter.ingress.hasDefaultPath false
config *.switch.bridging.streamFilter.ingress.classifier.mapping "{\"misbehaving traffic\": 0, \"normal traffic\": 1}"
config *.switch.bridging.streamFilter.ingress.meter[0].display-name "misbehaving traffic"
config *.switch.bridging.streamFilter.ingress.meter[1].display-name "normal traffic"
config *.switch*.bridging.streamFilter.ingress.meter[*].typename SlidingWindowRateMeter
config *.switch*.bridging.streamFilter.ingress.meter[*].timeWindow 15ms
config *.switch*.bridging.streamFilter.ingress.filter[*].typename StatisticalRateLimiter
config *.switch*.bridging.streamFilter.ingress.filter[0].maxDatarate 40Mbps
config *.switch*.bridging.streamFilter.ingress.filter[1].maxDatarate 20Mbps
config network StatisticalPolicingShowcaseNetwork
config *.*.eth[*].bitrate 100Mbps
config *.client1.eth[0].macLayer.queue.typename DropTailQueue
config *.client1.eth[0].macLayer.queue.packetCapacity 100
config *.client*.numApps 1
config *.client*.app[*].typename UdpSourceApp
config *.client1.app[0].display-name "misbehaving traffic"
config *.client2.app[0].display-name "normal traffic"
config *.client*.app[0].io.destAddress "\"server\""
config *.client1.app[0].io.destPort 1000
config *.client2.app[0].io.destPort 1001
config *.client1.app[0].io.displayStringTextFormat "\"{numSent} misbehaving traffic\""
config *.client2.app[0].io.displayStringTextFormat "\"{numSent} normal traffic\""
config *.client1.app[0].source.packetLength 25B
config *.client1.app[0].source.productionInterval "10us + replaceUnit(sin(dropUnit(simTime() * 10)), \"ms\") / 256 + replaceUnit(sin(dropUnit(simTime() * 125)), \"ms\") / 512"
config *.client2.app[0].source.packetLength 500B
config *.client2.app[0].source.productionInterval 250us
config *.server.numApps 2
config *.server.app[*].typename UdpSinkApp
config *.server.app[0].display-name "misbehaving traffic"
config *.server.app[1].display-name "normal traffic"
config *.server.app[0].io.localPort 1000
config *.server.app[1].io.localPort 1001
config *.server.app[0].io.displayStringTextFormat "\"{numReceived} misbehaving traffic\""
config *.server.app[1].io.displayStringTextFormat "\"{numReceived} normal traffic\""
config *.visualizer.infoVisualizer.displayInfos true
config *.visualizer.infoVisualizer.placementHint "\"top\""
config *.visualizer.infoVisualizer.modules "\"*.*.app[*].io\""
config *.visualizer.networkNodeVisualizer.annotationSpacing 12

