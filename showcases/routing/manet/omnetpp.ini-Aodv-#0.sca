config *.visualizer.networkRouteVisualizer[0].packetFilter "\"*ping*\""
config *.visualizer.interfaceTableVisualizer[0].displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer[0].format "\"%a/%l\""
