config *.visualizer.numDataLinkVisualizers 5
config *.visualizer.dataLinkVisualizer[*].activityLevel "\"peer\""
config *.visualizer.dataLinkVisualizer[*].displayLinks true
config *.visualizer.dataLinkVisualizer[0].packetFilter "\"aodv::Rreq or GPSRBeacon\""
config *.visualizer.dataLinkVisualizer[1].packetFilter "\"ping* or UDP*\""
