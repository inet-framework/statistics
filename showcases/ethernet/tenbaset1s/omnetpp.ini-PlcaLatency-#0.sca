version 3
run PlcaLatency-0-20261121-10:50:36-1260
attr configname PlcaLatency
attr datetime 20261121-10:50:36
attr datetimef 20261121-105036
attr experiment PlcaLatency
attr inifile omnetpp.ini
attr iterationvars "$N=8, $load=30"
attr iterationvarsd N=8/load=30
attr iterationvarsf N=8,load=30-
attr measurement "$N=8, $load=30"
attr network inet.showcases.ethernet.tenbaset1s.MultidropNetwork
attr processid 1260
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar N 8
itervar load 30
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-PlcaLatency-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-PlcaLatency-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 2s
config extends PlcaBase
config repeat 3
config *.numNodes 8
config *.controller.numApps "1 + 8"
config *.node[*].app[0].source.productionInterval "uniform(0.9, 1.1) * 1.25 * 8 * 68us * 100 / 30"
config *.node[*].app[0].source.initialProductionOffset "uniform(0s, 1.25 * 8 * 68us * 100 / 30)"
config *.controller.app[*].source.productionInterval "uniform(0.9, 1.1) * 4 * 1.25 * 8 * 68us * 100 / 30"
config *.controller.app[*].source.initialProductionOffset "uniform(0s, 4 * 1.25 * 8 * 68us * 100 / 30)"
config *.*.eth[*].plca.packetPendingDelay:vector.vector-recording true
config *.*.eth[*].mac.packetPendingDelay:vector.vector-recording true
config *.*.eth[*].plca.max_bc 0
config network inet.showcases.ethernet.tenbaset1s.MultidropNetwork
config seed-set 0
config **.vector-recording false
config *.controller.typename EthernetPlcaHost
config *.node[*].typename EthernetPlcaHost
config *.*.ethernet.hasSocketSupport true
config *.node[*].numApps 2
config *.node[*].app[0].typename EthernetSourceApp
config *.node[*].app[0].io.interface "\"eth0\""
config *.node[*].app[0].io.remoteAddress "\"controller\""
config *.node[*].app[0].source.packetLength 46B
config *.node[*].app[1].typename EthernetSinkApp
config *.node[*].app[1].io.interface "\"eth0\""
config *.node[*].app[1].io.steal true
config *.node[*].app[1].io.localAddress "\"node[\" + string(ancestorIndex(2)) + \"]\""
config *.controller.app[0].typename EthernetSinkApp
config *.controller.app[0].io.interface "\"eth0\""
config *.controller.app[0].io.steal true
config *.controller.app[0].io.localAddress "\"controller\""
config *.controller.app[0].io.remoteAddress "\"\""
config *.controller.app[*].typename EthernetSourceApp
config *.controller.app[*].io.interface "\"eth0\""
config *.controller.app[*].io.remoteAddress "\"node[\" + string(ancestorIndex(1) - 1) + \"]\""
config *.controller.app[*].source.packetLength 46B

