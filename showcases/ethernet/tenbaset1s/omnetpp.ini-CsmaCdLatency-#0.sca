config *.controller.app[*].source.productionInterval "uniform(0.9, 1.1) * 4 * 1.25 * 8 * 68us * 100 / 30"
config *.controller.app[*].source.initialProductionOffset "uniform(0s, 4 * 1.25 * 8 * 68us * 100 / 30)"
config *.*.eth[*].mac.packetPendingDelay:vector.vector-recording true
config **.plca.typename ""
config network inet.showcases.ethernet.tenbaset1s.MultidropNetwork
config seed-set 0
config **.vector-recording false
config *.controller.typename EthernetPlcaHost
config *.node[*].typename EthernetPlcaHost
config *.*.ethernet.hasSocketSupport true
config *.node[*].numApps 2
config *.node[*].app[0].typename EthernetSourceApp
config *.node[*].app[0].io.interface "\"eth0\""
