version 3
run CsmaCdLatency-0-20261121-10:50:36-1259
attr configname CsmaCdLatency
attr datetime 20261121-10:50:36
attr datetimef 20261121-105036
attr experiment CsmaCdLatency
attr inifile omnetpp.ini
attr iterationvars $load=30
attr iterationvarsd load=30
attr iterationvarsf load=30-
attr measurement $load=30
attr network inet.showcases.ethernet.tenbaset1s.MultidropNetwork
attr processid 1259
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar load 30
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-CsmaCdLatency-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-CsmaCdLatency-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 2s
config extends CsmaCdBase
config repeat 10
config *.numNodes 8
config *.controller.numApps 9
config *.node[*].app[0].source.productionInterval "uniform(0.9, 1.1) * 1.25 * 8 * 68us * 100 / 30"
