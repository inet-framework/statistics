config record-eventlog false
config sim-time-limit 2.1s
config extends CsmaCdBase
config warmup-period 0.1s
config repeat 10
config *.numNodes 8
config *.controller.numApps 9
config *.node[*].app[0].source.packetLength 1500B
config *.controller.app[*].source.packetLength 1500B
config *.node[*].app[0].source.productionInterval 200us
config *.controller.app[*].source.productionInterval 200us
config **.plca.typename ""
config network inet.showcases.ethernet.tenbaset1s.MultidropNetwork
config seed-set 0
config **.vector-recording false
config *.controller.typename EthernetPlcaHost
config *.node[*].typename EthernetPlcaHost
config *.*.ethernet.hasSocketSupport true
config *.node[*].numApps 2
config *.node[*].app[0].typename EthernetSourceApp
config *.node[*].app[0].io.interface "\"eth0\""
config *.node[*].app[0].io.remoteAddress "\"controller\""
config *.node[*].app[1].typename EthernetSinkApp
config *.node[*].app[1].io.interface "\"eth0\""
config *.node[*].app[1].io.steal true
config *.node[*].app[1].io.localAddress "\"node[\" + string(ancestorIndex(2)) + \"]\""
config *.controller.app[0].typename EthernetSinkApp
config *.controller.app[0].io.interface "\"eth0\""
