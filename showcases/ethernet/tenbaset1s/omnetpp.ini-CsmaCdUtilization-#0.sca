version 3
run CsmaCdUtilization-0-20261121-10:50:36-1261
attr configname CsmaCdUtilization
attr datetime 20261121-10:50:36
attr datetimef 20261121-105036
attr experiment CsmaCdUtilization
attr inifile omnetpp.ini
attr iterationvars $payloadLength=1500
attr iterationvarsd payloadLength=1500
attr iterationvarsf payloadLength=1500-
attr measurement $payloadLength=1500
attr network inet.showcases.ethernet.tenbaset1s.MultidropNetwork
attr processid 1261
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar payloadLength 1500
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-CsmaCdUtilization-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-CsmaCdUtilization-#0.vec
