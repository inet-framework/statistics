itervar bw 10
itervar delay 10
itervar mtu 1280
itervar ql 100000
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-General-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-General-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 50s
config network QuicLinkSharingShowcase
config **.quic.initialMaxData 4294967295B
config **.quic.initialMaxStreamData 4294967295B
config **.bottleneckDelay 10ms
config **.bottleneckDatarate 10Mbps
config **.ppp[*].ppp.mtu 1280B
config **.router1.ppp[4].queue.dataCapacity "10 * 2*10 kb"
config **.sender*.hasQuic true
config **.sender*.numApps 1
config **.sender*.app[*].typename TrafficgenCompound
config **.sender*.app[0].numGenerators 1
config **.sender*.app[0].generator[0].typename TrafficgenSimple
config **.sender*.app[0].generator[0].id 0
config **.sender*.app[0].generator[0].packetSize 100kB
config **.sender*.app[0].generator[0].packetInterval 0ms
config **.sender*.app[0].generator[0].ordered false
config **.sender1.app[0].generator[0].startTime 5s
