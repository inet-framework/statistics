config **.sender*.app[*].handler.connectPort 1000
config **.sender1.app[*].handler.connectAddress "\"receiver1\""
config **.sender2.app[*].handler.connectAddress "\"receiver2\""
config **.sender3.app[*].handler.connectAddress "\"receiver3\""
config **.sender*.quic.accurateIncreaseInNewRenoCongestionAvoidance true
config **.sender*.quic.sendQueueLimit 100000B
config **.sender*.quic.sendQueueLowWaterRatio .8
config **.quic.bundleAckForNonAckElicitingPackets true
config **.receiver*.hasQuic true
config **.receiver*.numApps 1
config **.receiver*.app[0].typename QuicDiscardServer
config **.receiver*.app[0].localAddress "\"\""
