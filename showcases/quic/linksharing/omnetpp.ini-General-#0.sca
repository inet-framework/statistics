config **.receiver*.quic.numReceivedAckElicitingsBeforeAck 2
config **.background*.numApps 1
config **.backgroundSender.app[0].typename UdpBasicApp
config **.background*.app[0].localPort 100
config **.background*.app[0].destPort 100
config **.backgroundReceiver.app[0].typename UdpSink
config **.backgroundReceiver.app[0].destAddresses "\"\""
config **.backgroundSender.app[0].messageLength int(uniform(500B,1000B))
config **.backgroundSender.app[0].sendInterval uniform(10ms,20ms)
config **.backgroundSender.app[0].startTime 0s
config **.backgroundSender.app[0].stopTime 50s
config **.backgroundSender.app[0].destAddresses "\"backgroundReceiver\""
