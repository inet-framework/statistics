config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Basic-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Basic-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 5s
config *.client*.numApps 2
config *.client*.app[*].typename UdpSourceApp
config *.client*.app[0].source.packetNameFormat "\"background-%c\""
config *.client*.app[1].source.packetNameFormat "\"video-%c\""
config *.client*.app[0].io.destAddress "\"server1\""
config *.client*.app[1].io.destAddress "\"server2\""
config *.client*.app[*].io.destPort 1000
config *.client*.app[0].source.packetLength 1000B
config *.client*.app[0].source.productionInterval truncnormal(200us,100us)
config *.client*.app[1].source.packetLength 500B
config *.client*.app[1].source.productionInterval truncnormal(2ms,1ms)
config *.client*.app[*].measurementStarter.typename FlowMeasurementStarter
config *.client1.app[0].measurementStarter.flowName "\"c1s1\""
config *.client1.app[1].measurementStarter.flowName "\"c1s2\""
config *.client1.app[*].measurementStarter.measure "\"elapsedTime or queueingTime\""
config *.client2.app[0].measurementStarter.flowName "\"c2s1\""
config *.client2.app[1].measurementStarter.flowName "\"c2s2\""
config *.client2.app[*].measurementStarter.measure "\"elapsedTime or queueingTime\""
config *.server*.app[*].measurementRecorder.typename FlowMeasurementRecorder
config *.server1.app[0].measurementRecorder.flowName "\"c1s1 or c1s2 or c2s1 or c2s2\""
config *.server1.app[*].measurementRecorder.measure "\"elapsedTime or queueingTime\""
config *.server2.app[0].measurementRecorder.flowName "\"c1s1 or c1s2 or c2s1 or c2s2\""
config *.server2.app[*].measurementRecorder.measure "\"elapsedTime or queueingTime\""
config *.switch*.eth[2].measurementLayer.typename MeasurementLayer
config *.switch1.eth[2].measurementLayer.measurementStarter.flowName "\"sw1sw2\""
config *.switch1.eth[2].measurementLayer.measurementStarter.measure "\"elapsedTime or queueingTime\""
config *.switch2.eth[2].measurementLayer.measurementRecorder.flowName "\"sw1sw2\""
config *.switch2.eth[2].measurementLayer.measurementRecorder.measure "\"elapsedTime or queueingTime\""
config network FlowMeasurementShowcase
config *.*.ethernet.typename EthernetLayer
config *.*.eth[*].typename LayeredEthernetInterface
config *.*.eth[*].bitrate 100Mbps
config *.*.eth[*].phyLayer.*Emitter.typename ""
config *.server*.numApps 1
config *.server*.app[0].typename UdpSinkApp
config *.server*.app[0].io.localPort 1000
config *.visualizer.packetFlowVisualizer.displayRoutes true
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer.format "\"%N %\\\\%a/%l%\\\\%m\""
config **.checksumMode "\"computed\""
config **.fcsMode "\"computed\""

