config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-AnyLocation-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-AnyLocation-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 5s
config *.client*.numApps 2
config *.client*.app[*].typename UdpBasicApp
config *.client1.app[0].packetName "\"c1-background\""
config *.client1.app[1].packetName "\"c1-video\""
config *.client2.app[0].packetName "\"c2-background\""
config *.client2.app[1].packetName "\"c2-video\""
config *.client*.app[0].destAddresses "\"server1 server2\""
config *.client*.app[1].destAddresses "\"server1 server2\""
config *.client*.app[*].destPort 1000
config *.client*.app[0].localPort 1000
config *.client*.app[1].localPort 500
config *.client*.app[0].messageLength 1000B
config *.client*.app[0].sendInterval truncnormal(200us,100us)
config *.client*.app[1].messageLength 500B
config *.client*.app[1].sendInterval truncnormal(2ms,1ms)
config *.client*.typename MyStandardHost
config *.server*.typename MyStandardHost
config *.client*.measurementLayer.typename MultiMeasurementLayer
config *.server*.measurementLayer.typename MultiMeasurementLayer
config *.client*.measurementLayer.numMeasurementModules 2
config *.client*.measurementLayer.measurementStarter[0].flowName "\"VID\""
config *.client*.measurementLayer.measurementStarter[0].packetFilter "expr(has(udp) && udp.srcPort == 500)"
config *.client*.measurementLayer.measurementStarter[1].flowName "\"BG\""
config *.client*.measurementLayer.measurementStarter[1].packetFilter "expr(has(udp) && udp.srcPort == 1000)"
config *.client*.measurementLayer.measurementStarter[*].measure "\"elapsedTime or queueingTime\""
config *.client*.measurementLayer.measurementMaker[*].typename ""
config *.server*.measurementLayer.measurementMaker[0].flowName "\"VID or BG\""
config *.server*.measurementLayer.measurementMaker[*].measure "\"elapsedTime or queueingTime\""
config *.server*.measurementLayer.measurementStarter[*].typename ""
config network FlowMeasurementShowcase
config *.*.ethernet.typename EthernetLayer
config *.*.eth[*].typename LayeredEthernetInterface
config *.*.eth[*].bitrate 100Mbps
config *.*.eth[*].phyLayer.*Emitter.typename ""
config *.server*.numApps 1
config *.server*.app[0].typename UdpSinkApp
config *.server*.app[0].io.localPort 1000
config *.visualizer.packetFlowVisualizer.displayRoutes true
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer.format "\"%N %\\\\%a/%l%\\\\%m\""
config **.checksumMode "\"computed\""
config **.fcsMode "\"computed\""

