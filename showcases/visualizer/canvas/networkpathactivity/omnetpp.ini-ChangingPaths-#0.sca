config *.wirelessSource.wlan[0].agent.defaultSsid "\"inet\""
config *.accessPoint1.wlan[0].mgmt.ssid "\"omnet\""
config *.wirelessDestination.wlan[0].agent.defaultSsid "\"omnet\""
config *.visualizer.networkRouteVisualizer.displayRoutes true
config *.visualizer.networkRouteVisualizer.packetFilter "\"ping* and not *reply\""
config *.visualizer.networkRouteVisualizer.fadeOutMode "\"simulationTime\""
config *.visualizer.networkRouteVisualizer.fadeOutTime 1.4s

