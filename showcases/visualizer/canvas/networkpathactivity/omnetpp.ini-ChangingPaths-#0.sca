config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-ChangingPaths-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-ChangingPaths-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 250s
config description "Displaying Visualizer's Reaction to Routing Changes"
config network NetworkPathRIPShowcase
config *.router*.hasRip true
config **.hasStatus true
config *.configurator.config "xmldoc(\"configuration.xml\")"
config *.scenarioManager.script "xmldoc(\"changeRoute.xml\")"
config *.*Source.numApps 1
config *.*Source.app[0].typename PingApp
config *.wiredSource.app[0].destAddr "\"wiredDestination\""
config *.wirelessSource.app[0].destAddr "\"wirelessDestination\""
