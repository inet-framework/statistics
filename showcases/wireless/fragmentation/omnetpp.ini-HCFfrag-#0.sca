config record-eventlog false
config sim-time-limit 10s
config *.wifiHost*.wlan[*].mac.qosStation true
config *.wifiHost*.wlan[*].classifier.typename QosClassifier
config **.mac.hcf.originatorMacDataService.msduAggregationPolicy.typename ""
config **.mac.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold 250B
