attr datetimef 20261117-192313
attr experiment HCFfrag
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network FragmentationShowcase
attr processid 1364
