attr experiment OnlyPacketSizeHCFfragblockack
attr inifile parameterstudy.ini
attr iterationvars $packetSize=100
attr iterationvarsd packetSize=100
attr iterationvarsf packetSize=100-
attr measurement $packetSize=100
attr network FragmentationShowcase
attr processid 1217
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar packetSize 100
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/parameterstudy.ini-OnlyPacketSizeHCFfragblockack-#0.sca
config output-scalar-precision 17
config output-vector-file results/parameterstudy.ini-OnlyPacketSizeHCFfragblockack-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 10s
config extends OnlyPacketSizeHCFfrag,OnlyPacketSizeIteration
config **.maxBlockAckPolicyFrameLength 2000B
config *.*.wlan[*].mac.hcf.isBlockAckSupported true
config *.wifiHost*.wlan[*].mac.hcf.blockAckVariant "\"basic\""
