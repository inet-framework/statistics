version 3
run PacketSizeHCFfrag-0-20260916-13:05:25-5545
attr configname PacketSizeHCFfrag
attr datetime 20260916-13:05:25
attr datetimef 20260916-130525
attr experiment PacketSizeHCFfrag
attr inifile parameterstudy.ini
attr iterationvars $packetSize=100
attr iterationvarsd packetSize=100
attr iterationvarsf packetSize=100-
attr measurement $packetSize=100
attr network FragmentationShowcase
attr processid 5545
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
itervar packetSize 100
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/parameterstudy.ini-PacketSizeHCFfrag-#0.sca
config output-scalar-precision 17
config output-vector-file results/parameterstudy.ini-PacketSizeHCFfrag-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1s
config extends IterationPacketSize
config **.fragmentationThreshold "int((100 + 8 + 20 + 8 + 15) / 16) * 1B + 26B + 4B"
config *.*.wlan[*].mac.qosStation true
config *.*.wlan[*].mac.hcf.isBlockAckSupported false
config **.wlan[*].classifier.typename QosClassifier
config **.mac.hcf.originatorMacDataService.msduAggregationPolicy.typename ""
config *.wifiHost1.app[0].destPort 4000
config *.wifiHost2.app[0].localPort 4000
config *.wifiHost1.app[0].messageLength 100B
config **.mtu 12250B
config network FragmentationShowcase
config **.app*.throughput:vector.vector-recording true
config **.*.wlan[*].radio.minSnir:vector.vector-recording true
config **.app*.throughput.result-recording-modes +vector
config **.*.wlan[*].radio.minSnir.result-recording-modes +vector
config **.vector-recording false
config **.arp.typename GlobalArp
config *.wifiHost1.numApps 1
config *.wifiHost1.app[0].typename UdpBasicApp
config *.wifiHost1.app[0].destAddresses "\"wifiHost2\""
config *.wifiHost1.app[0].sendInterval 0.5ms
config *.wifiHost2.numApps 1
config *.wifiHost2.app[0].typename UdpSink
config *.wifiHost*.wlan[*].radio.receiver.energyDetection -105dBm
config *.wifiHost*.wlan[*].radio.receiver.sensitivity -105dBm
config *.wifiHost*.wlan[*].radio.receiver.snirThreshold 0dB
config *.wifiHost*.wlan[*].radio.transmitter.power 0.08mW
config *.visualizer.dataLinkVisualizer.displayLinks true
config *.visualizer.physicalLinkVisualizer.displayLinks true
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.interfaceTableVisualizer.format "\"%N %\\\\%a/%l\\n%m\""

