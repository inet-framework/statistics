config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-MixedTraffic-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-MixedTraffic-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1s
config description "Mixed traffic of packets shorter and longer than blockAckReqThreshold"
config *.host1.numApps 2
config *.host1.app[1].typename UdpBasicApp
config *.host1.app[1].destAddresses "\"host2\""
config *.host1.app[1].destPort 2000
config *.host1.app[1].messageLength 1700B
config *.host1.app[1].sendInterval 0.1ms
config *.host1.app[1].packetName "\"Large\""
config *.host2.numApps 2
config *.host2.app[1].typename UdpSink
