config description "Mixed traffic of packets shorter and longer than blockAckReqThreshold"
config *.host1.numApps 2
config *.host1.app[1].typename UdpBasicApp
config *.host1.app[1].destAddresses "\"host2\""
config *.host1.app[1].destPort 2000
