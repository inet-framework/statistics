version 3
run NoFragmentation-0-20261117-19:23:12-1353
attr configname NoFragmentation
attr datetime 20261117-19:23:12
attr datetimef 20261117-192312
attr experiment NoFragmentation
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network BlockAckShowcase
attr processid 1353
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-NoFragmentation-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-NoFragmentation-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 1s
config description "Packets are not fragmented, block ack after 5 packet transmissions (default)"
config network BlockAckShowcase
config *.host1.numApps 1
config *.host1.app[0].typename UdpBasicApp
config *.host1.app[0].destAddresses "\"host2\""
config *.host1.app[0].destPort 1000
config *.host1.app[0].messageLength 700B
config *.host1.app[0].sendInterval 0.1ms
config *.host1.app[0].packetName "\"Data\""
config *.host2.numApps 1
config *.host2.app[0].typename UdpSink
config *.host2.app[0].localPort 1000
config *.host*.ipv4.arp.typename GlobalArp
config *.host*.wlan[*].mac.qosStation true
config *.host*.wlan[*].classifier.typename QosClassifier
config *.host*.wlan[*].mac.hcf.isBlockAckSupported true
config *.host*.wlan[*].mac.hcf.blockAckVariant "\"basic\""
config *.host*.wlan[*].radio.receiver.energyDetection -105dBm
config *.host*.wlan[*].radio.receiver.sensitivity -105dBm
config *.host*.wlan[*].radio.receiver.snirThreshold 0dB
config *.host*.wlan[*].radio.transmitter.power 0.12mW
config **.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold 10000B
config **.hcf.originatorMacDataService.msduAggregationPolicy.aggregationLengthThreshold 10000
config *.visualizer.physicalLinkVisualizer.displayLinks true
config *.visualizer.dataLinkVisualizer.displayLinks true
config *.visualizer.infoVisualizer.modules "\"*.host2.app[0]\""
config *.visualizer.infoVisualizer.format "\"%t\""
config *.visualizer.packetDropVisualizer.displayPacketDrops true
config *.visualizer.packetDropVisualizer.labelFormat "\"%r\""

