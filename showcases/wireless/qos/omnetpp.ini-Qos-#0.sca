config **.param-recording false
config image-path /home/runner/work/inet/inet/inet/images
config output-scalar-file results/omnetpp.ini-Qos-#0.sca
config output-scalar-precision 17
config output-vector-file results/omnetpp.ini-Qos-#0.vec
config output-vector-precision 17
config record-eventlog false
config sim-time-limit 10s
config extends NonQos
config *.*.wlan[*].mac.qosStation true
config *.*.wlan[*].classifier.typename QosClassifier
config network QosShowcase
config *.*.wlan[*].bitrate 54Mbps
config *.client.numApps 4
config *.client.app[*].typename UdpBasicApp
config *.client.app[*].destAddresses "\"server\""
config *.client.app[*].startTime 1.0s+sendInterval*index/4
config *.client.app[*].stopTime 6.0s
config *.client.app[0].destPort 21
config *.client.app[1].destPort 80
config *.client.app[2].destPort 4000
config *.client.app[3].destPort 5000
config *.client.app[0].packetName "\"background\""
config *.client.app[1].packetName "\"best effort\""
config *.client.app[2].packetName "\"video\""
config *.client.app[3].packetName "\"voice\""
config *.server.numApps 4
config *.server.app[*].typename UdpSink
config *.server.app[0].localPort 21
config *.server.app[1].localPort 80
config *.server.app[2].localPort 4000
config *.server.app[3].localPort 5000
config *.client.app[0].messageLength 900B
config *.client.app[0].sendInterval normal(300us,10us)
config *.client.app[1].messageLength 900B
config *.client.app[1].sendInterval normal(250us,10us)
config *.client.app[2].messageLength 600B
